        document.getElementById('btnInstallApp').addEventListener('click', () => {
            audio.init();
            document.getElementById('installAppModal').classList.remove('hidden');
        });

        document.getElementById('btnTriggerNativeInstall').addEventListener('click', async () => {
            if (!deferredInstallPrompt) return;
            try {
                deferredInstallPrompt.prompt();
                const choice = await deferredInstallPrompt.userChoice;
                if (choice && choice.outcome === 'accepted') {
                    showToast('📲 Instalando Jornada Espacial...');
                }
                deferredInstallPrompt = null;
                document.getElementById('nativeInstallAvailableBox').classList.add('hidden');
            } catch (e) {}
        });

        document.getElementById('btnOpenApkDownloadLink').addEventListener('click', () => {
            const targetUrl = MONETIZATION_CONFIG.apkDownloadUrl || MONETIZATION_CONFIG.smartlinkUrl;
