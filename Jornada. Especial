        function getEffectiveAbilityCooldown() {
            const ability = getActiveAbility();
            const mult = hasRelic('neptune_eye') ? 0.80 : 1.0;
            return +(ability.cooldown * mult).toFixed(1);
        }

        function rollDamageWithCrit(baseDmg) {
            let critChance = 0;
            if (hasRelic('mars_core')) critChance += 0.15;
            critChance += (runMerchantBuffs.critBonus || 0);
            if (critChance > 0 && Math.random() < critChance) {
                return { dmg: baseDmg * 2.5, isCrit: true };
            }
            return { dmg: baseDmg, isCrit: false };
        }

