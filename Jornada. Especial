        function drawCosmicWheel(angleRad) {
            const wCanvas = document.getElementById('cosmicWheelCanvas');
            if (!wCanvas) return;
            const wCtx = wCanvas.getContext('2d');
            const cx = wCanvas.width / 2;
            const cy = wCanvas.height / 2;
            const radius = cx - 6;
            const sliceAngle = (Math.PI * 2) / COSMIC_WHEEL_SLICES.length;

            wCtx.clearRect(0, 0, wCanvas.width, wCanvas.height);

            COSMIC_WHEEL_SLICES.forEach((slice, i) => {
                const startA = angleRad + i * sliceAngle;
                const endA = startA + sliceAngle;

                wCtx.beginPath();
                wCtx.moveTo(cx, cy);
                wCtx.arc(cx, cy, radius, startA, endA);
                wCtx.closePath();
                wCtx.fillStyle = slice.color;
                wCtx.fill();
                wCtx.strokeStyle = '#070b14';
                wCtx.lineWidth = 2.5;
                wCtx.stroke();

                wCtx.save();
                wCtx.translate(cx, cy);
                wCtx.rotate(startA + sliceAngle / 2);
                wCtx.fillStyle = slice.textColor;
                wCtx.font = 'bold 10px Orbitron';
                wCtx.textAlign = 'right';
                wCtx.textBaseline = 'middle';
                wCtx.fillText(slice.label, radius - 14, 0);
                wCtx.restore();
            });

            wCtx.fillStyle = '#070b14';
            wCtx.strokeStyle = '#00ffff';
            wCtx.lineWidth = 3;
            wCtx.beginPath();
            wCtx.arc(cx, cy, 20, 0, Math.PI * 2);
            wCtx.fill();
            wCtx.stroke();

            wCtx.fillStyle = '#00ffff';
            wCtx.font = 'bold 11px Orbitron';
            wCtx.textAlign = 'center';
            wCtx.textBaseline = 'middle';
            wCtx.fillText('⚡', cx, cy + 1);
        }

