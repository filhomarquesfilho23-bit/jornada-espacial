<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <!-- Mobile PWA & Android WebApp Meta Tags -->
    <meta name="theme-color" content="#070b14">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Jornada Espacial">
    <meta name="description" content="Jornada Espacial — Edição Comandante de Frota (V7.0). Pilote sua nave, comande wingmen aliados, enfrente o Boss Rush e conquiste o cosmos.">
    <title>Jornada Espacial — Edição Comandante de Frota V7.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Orbitron:wght@500;700;800;900&display=swap" rel="stylesheet">
    <style>
        * {
            box-sizing: border-box;
            user-select: none;
            -webkit-user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
        }
        html, body {
            position: fixed;
            inset: 0;
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #070b14;
            font-family: 'Inter', sans-serif;
            color: #e2e8f0;
        }
        .font-display {
            font-family: 'Orbitron', sans-serif;
        }
        canvas#game-canvas {
            position: fixed;
            inset: 0;
            width: 100vw;
            height: 100vh;
            display: block;
            z-index: 1;
            background: #070b14;
            touch-action: none;
        }
        #hud {
            z-index: 10;
            pointer-events: none;
        }
        #mobileControls {
            z-index: 15;
            pointer-events: none;
        }
        #menu-screen,
        #planetModal,
        #hangarModal,
        #workshopModal,
        #missionsModal,
        #trialsModal,
        #pilotProfileModal,
        #catalogModal,
        #codesModal,
        #merchant-screen,
        #pause-screen,
        #gameover-screen,
        #recordPosterModal,
        #installAppModal,
        #cosmicWheelModal,
        #seasonPassModal,
        #resetConfirmModal {
            z-index: 20;
        }
        .neon-text {
            text-shadow: 0 0 10px rgba(0, 210, 255, 0.7), 0 0 24px rgba(0, 255, 255, 0.45);
        }
        .glass-panel {
            background: rgba(13, 17, 23, 0.92);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 210, 255, 0.34);
            box-shadow: 0 0 32px rgba(0, 210, 255, 0.14), inset 0 0 20px rgba(0, 255, 255, 0.05);
        }
        .btn-cyber {
            background: linear-gradient(135deg, rgba(0, 210, 255, 0.22), rgba(0, 255, 255, 0.1));
            border: 1px solid rgba(0, 255, 255, 0.55);
            color: #ffffff;
            transition: transform 0.12s ease, box-shadow 0.2s ease, background 0.2s ease;
            touch-action: manipulation;
        }
        .btn-cyber:active {
            transform: scale(0.96);
        }
        .btn-primary-glow {
            background: linear-gradient(135deg, #00d2ff 0%, #00ffff 100%);
            color: #070b14;
            font-weight: 800;
            box-shadow: 0 0 22px rgba(0, 255, 255, 0.5);
            transition: transform 0.12s ease, box-shadow 0.2s ease;
            touch-action: manipulation;
        }
        .btn-primary-glow:active {
            transform: scale(0.96);
        }
        .btn-gold-glow {
            background: linear-gradient(135deg, #f59e0b 0%, #fde047 100%);
            color: #070b14;
            font-weight: 800;
            box-shadow: 0 0 22px rgba(250, 204, 21, 0.55);
            transition: transform 0.12s ease, box-shadow 0.2s ease;
            touch-action: manipulation;
        }
        .btn-gold-glow:active {
            transform: scale(0.96);
        }
        button {
            touch-action: manipulation;
        }
        .custom-scroll {
            touch-action: pan-y;
            -webkit-overflow-scrolling: touch;
        }
        .custom-scroll::-webkit-scrollbar {
            width: 5px;
        }
        .custom-scroll::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
            border-radius: 999px;
        }
        .custom-scroll::-webkit-scrollbar-thumb {
            background: rgba(0, 210, 255, 0.45);
            border-radius: 999px;
        }
        @keyframes pulseGlow {
            0%, 100% { box-shadow: 0 0 14px rgba(0, 255, 255, 0.35); }
            50% { box-shadow: 0 0 28px rgba(0, 255, 255, 0.8); }
        }
        .pulse-glow {
            animation: pulseGlow 2.2s infinite;
        }
        @keyframes shipHover {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-3px); }
        }
        .ship-float {
            animation: shipHover 2.4s ease-in-out infinite;
        }
    </style>
</head>
<body>

    <!-- CANVAS PRINCIPAL DO JOGO -->
    <canvas id="game-canvas"></canvas>

    <!-- NOTIFICAÇÃO TOAST FLUTUANTE -->
    <div id="toastBanner" class="hidden fixed top-4 left-1/2 -translate-x-1/2 z-[70] px-4 py-2.5 rounded-2xl bg-slate-900/95 border border-cyan-400/70 text-cyan-200 font-display text-xs tracking-wider shadow-lg text-center max-w-[92vw] pointer-events-none">
        Mensagem do Sistema
    </div>

    <!-- HUD SUPERIOR (POINTER-EVENTS-NONE EXCETO BOTÕES CLICÁVEIS) -->
    <div id="hud" class="hidden fixed inset-x-0 top-0 p-3 sm:p-4 flex flex-col gap-2">
        <div class="flex items-start justify-between gap-2 max-w-4xl mx-auto w-full">
            <!-- Escudo, Energia & Overdrive -->
            <div class="glass-panel rounded-2xl p-2.5 sm:p-3 flex flex-col gap-1.5 min-w-[152px] sm:min-w-[198px]">
                <div class="flex items-center justify-between text-[10px] sm:text-xs font-display tracking-wider">
                    <span class="text-cyan-300">ESCUDO</span>
                    <span id="shieldText" class="text-white font-bold">100%</span>
                </div>
                <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-cyan-500/30">
                    <div id="shieldBar" class="h-full bg-gradient-to-r from-cyan-500 to-cyan-300 transition-all duration-150" style="width: 100%;"></div>
                </div>

                <div class="flex items-center justify-between text-[10px] sm:text-xs font-display tracking-wider mt-0.5">
                    <span class="text-amber-300">ENERGIA</span>
                    <span id="energyText" class="text-white font-bold">100%</span>
                </div>
                <div class="w-full h-2 bg-slate-900 rounded-full overflow-hidden border border-amber-500/30">
                    <div id="energyBar" class="h-full bg-gradient-to-r from-amber-500 to-yellow-300 transition-all duration-150" style="width: 100%;"></div>
                </div>

                <div class="flex items-center justify-between text-[10px] font-display tracking-wider mt-0.5">
                    <span id="overdriveLabel" class="text-fuchsia-300">OVERDRIVE</span>
                    <span id="overdriveText" class="text-white font-bold">0%</span>
                </div>
                <div class="w-full h-1.5 bg-slate-900 rounded-full overflow-hidden border border-fuchsia-500/30">
                    <div id="overdriveBar" class="h-full bg-gradient-to-r from-fuchsia-500 via-amber-400 to-cyan-300 transition-all duration-150" style="width: 0%;"></div>
                </div>
            </div>

            <!-- Pontuação, Combo, Cristais & Controles Rápidos -->
            <div class="flex flex-col items-end gap-1.5">
                <div class="flex items-center gap-1.5 pointer-events-auto">
                    <button type="button" id="btn-mute" class="glass-panel w-10 h-10 rounded-xl flex items-center justify-center text-sm text-cyan-300 hover:text-white active:scale-95 cursor-pointer" title="Alternar Áudio">
                        🔊
                    </button>
                    <button type="button" id="btn-pause" class="glass-panel w-10 h-10 rounded-xl flex items-center justify-center text-sm text-cyan-300 hover:text-white active:scale-95 cursor-pointer" title="Pausar Missão">
                        ⏸️
                    </button>
                </div>
                <div class="glass-panel rounded-2xl p-2.5 sm:p-3 flex flex-col items-end gap-0.5">
                    <div class="flex items-center gap-2">
                        <span id="comboBadge" class="hidden px-2 py-0.5 rounded-lg bg-amber-500/25 border border-amber-400/60 font-display text-[10px] font-extrabold text-amber-300">
                            x1 COMBO
                        </span>
                        <div class="text-[9px] sm:text-[10px] font-display text-cyan-400 tracking-widest">PONTOS</div>
                    </div>
                    <div id="scoreText" class="font-display text-base sm:text-xl font-extrabold text-white neon-text leading-tight">0</div>
                    <div class="flex items-center gap-2 text-[10px] sm:text-xs font-display mt-0.5">
                        <span class="text-amber-300">💎 <span id="runCrystalsText">0</span></span>
                        <span class="text-slate-600">|</span>
                        <span class="text-cyan-200"><span id="distanceText">0</span> km</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Barra de Progresso até o Próximo Planeta / Setor Abissal -->
        <div class="max-w-md mx-auto w-full glass-panel rounded-2xl px-3 py-2 flex flex-col gap-1">
            <div class="flex items-center justify-between text-[10px] sm:text-xs font-display">
                <span class="text-cyan-300 truncate">DESTINO: <strong id="nextPlanetName" class="text-white">MERCÚRIO</strong></span>
                <span id="planetPercentText" class="text-cyan-200 font-bold">0%</span>
            </div>
            <div class="w-full h-1.5 bg-slate-900 rounded-full overflow-hidden">
                <div id="planetProgressBar" class="h-full bg-gradient-to-r from-cyan-400 via-sky-300 to-emerald-400 transition-all duration-150" style="width: 0%;"></div>
            </div>
        </div>

        <!-- Barra de Vida do Chefão Guardião -->
        <div id="bossHudContainer" class="hidden max-w-md mx-auto w-full glass-panel rounded-2xl px-3.5 py-2 border-rose-500/60">
            <div class="flex items-center justify-between text-[10px] sm:text-xs font-display mb-1">
                <span class="text-rose-400 font-bold tracking-wider">⚠️ <span id="bossNameText">GUARDIÃO ORBITAL</span></span>
                <span id="bossHpText" class="text-white font-bold">100%</span>
            </div>
            <div class="w-full h-2 bg-slate-950 rounded-full overflow-hidden border border-rose-500/40">
                <div id="bossHpBar" class="h-full bg-gradient-to-r from-rose-600 via-red-500 to-amber-400 transition-all duration-100" style="width: 100%;"></div>
            </div>
        </div>

        <!-- Desafio Relâmpago (Bounty Cronometrado) -->
        <div id="bountyHudContainer" class="hidden max-w-md mx-auto w-full glass-panel rounded-2xl px-3.5 py-2 border-amber-400/70">
            <div class="flex items-center justify-between text-[10px] sm:text-xs font-display">
                <span class="text-amber-300 font-bold truncate">🎯 <span id="bountyDescText">BOUNTY RELÂMPAGO</span></span>
                <span class="text-white font-bold shrink-0 ml-2"><span id="bountyProgressText">0/10</span> • <span id="bountyTimeText" class="text-rose-300">15s</span></span>
            </div>
            <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden mt-1">
                <div id="bountyProgressBar" class="h-full bg-gradient-to-r from-amber-500 to-yellow-300 transition-all duration-100" style="width: 0%;"></div>
            </div>
        </div>

        <!-- Banner de Alerta Dinâmico -->
        <div id="eventAlertBanner" class="hidden max-w-xs mx-auto px-3.5 py-1 rounded-full bg-rose-600/90 border border-rose-300 text-white font-display text-[10px] sm:text-xs font-bold tracking-wider text-center shadow-lg animate-pulse">
            ⚠️ ALERTA ESPACIAL!
        </div>

        <!-- Indicadores de Power-Ups, Relíquias, Drone & Estase Ativos -->
        <div id="hudPowerups" class="flex items-center justify-center gap-1.5 flex-wrap max-w-md mx-auto"></div>
    </div>

    <!-- BOTÃO DE HABILIDADE ATIVA EQUIPADA (CANTO INFERIOR DIREITO) -->
    <div id="mobileControls" class="hidden fixed bottom-5 right-5 flex flex-col items-center gap-1">
        <button type="button" id="btn-skill" class="pointer-events-auto relative w-16 h-16 sm:w-20 sm:h-20 rounded-full glass-panel border-2 border-cyan-400 flex flex-col items-center justify-center active:scale-90 transition-transform shadow-lg pulse-glow cursor-pointer">
            <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none" viewBox="0 0 64 64">
                <circle cx="32" cy="32" r="29" fill="none" stroke="rgba(0,255,255,0.15)" stroke-width="3"></circle>
                <circle id="abilityCooldownRing" cx="32" cy="32" r="29" fill="none" stroke="#00ffff" stroke-width="3" stroke-dasharray="182.2" stroke-dashoffset="0" stroke-linecap="round"></circle>
            </svg>
            <span id="abilityBtnIcon" class="text-xl sm:text-2xl leading-none">⚡</span>
            <span id="turboBtnText" class="font-display text-[8px] sm:text-[9px] text-cyan-200 mt-1 font-bold tracking-wider">PRONTO</span>
        </button>
    </div>

    <!-- TELA INICIAL (MENU SCREEN) -->
    <div id="menu-screen" class="fixed inset-0 flex items-center justify-center p-3 sm:p-5 bg-slate-950/75 backdrop-blur-sm overflow-y-auto custom-scroll pb-20 pointer-events-auto">
        <div class="glass-panel rounded-3xl p-4 sm:p-6 max-w-md w-full text-center relative my-auto">
            <div class="flex items-center justify-between gap-1.5 mb-2">
                <button type="button" id="btnOpenPilotProfile" class="px-2.5 py-1.5 rounded-xl bg-cyan-500/15 border border-cyan-400/40 text-cyan-200 font-display text-[9px] font-bold tracking-wider hover:bg-cyan-500/25 cursor-pointer">
                    🎖️ <span id="startRankText">CADETE ESTELAR</span>
                </button>
                <div class="flex items-center gap-1.5">
                    <button type="button" id="btnInstallApp" class="px-2.5 py-1.5 rounded-xl bg-emerald-500/20 border border-emerald-400/60 text-emerald-200 font-display text-[9px] font-bold tracking-wider hover:bg-emerald-500/30 cursor-pointer">
                        📲 BAIXAR APP
                    </button>
                    <button type="button" id="btnDailyReward" class="px-2.5 py-1.5 rounded-xl bg-amber-500/20 border border-amber-400/60 text-amber-200 font-display text-[9px] font-bold tracking-wider animate-pulse cursor-pointer">
                        🎁 BÔNUS
                    </button>
                </div>
            </div>

            <h1 class="font-display text-2xl sm:text-3xl font-extrabold text-white neon-text tracking-wide mb-0.5">
                JORNADA <span class="text-cyan-400">ESPACIAL</span>
            </h1>
            <div class="text-[9px] sm:text-[10px] font-display text-purple-300 tracking-widest mb-2">
                EDIÇÃO COMANDANTE DE FROTA • V7.0
            </div>

            <!-- Barra Compacta do Passe Galáctico (10 Níveis) -->
            <button type="button" id="btnOpenSeasonPass" class="w-full mb-2.5 p-2.5 rounded-2xl bg-gradient-to-r from-indigo-950/80 via-slate-900/95 to-purple-950/80 border border-purple-400/45 hover:border-purple-300 text-left flex items-center justify-between gap-2.5 transition cursor-pointer">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center justify-between text-[9px] font-display mb-1">
                        <span class="text-purple-200 font-bold">🎖️ PASSE GALÁCTICO • <span id="startPassTierText" class="text-cyan-300">NÍVEL 1/10</span></span>
                        <span id="startPassXpText" class="text-amber-300 font-bold">0 / 250 XP</span>
                    </div>
                    <div class="w-full h-1.5 bg-slate-950 rounded-full overflow-hidden border border-purple-500/30">
                        <div id="startPassXpBar" class="h-full bg-gradient-to-r from-cyan-400 via-purple-400 to-amber-300 transition-all duration-300" style="width: 5%;"></div>
                    </div>
                </div>
                <span id="startPassReadyBadge" class="px-2 py-1 rounded-xl bg-purple-500/25 border border-purple-400/50 font-display text-[9px] font-bold text-purple-200 shrink-0">
                    VER PRÊMIOS
                </span>
            </button>

            <!-- Estatísticas Salvas -->
            <div class="grid grid-cols-3 gap-2 mb-2.5">
                <div class="bg-slate-900/85 border border-cyan-500/20 rounded-2xl p-2">
                    <div class="text-[9px] font-display text-slate-400 tracking-wider">RECORDE</div>
                    <div id="startHighScore" class="font-display text-sm sm:text-base font-bold text-cyan-300 mt-0.5">0</div>
                </div>
                <div class="bg-slate-900/85 border border-amber-500/20 rounded-2xl p-2">
                    <div class="text-[9px] font-display text-slate-400 tracking-wider">CRISTAIS</div>
                    <div id="startCrystalsCount" class="font-display text-sm sm:text-base font-bold text-amber-300 mt-0.5">0</div>
                    <div id="startMiningRateBadge" class="text-[8px] font-display text-emerald-400 mt-0.5">⛏️ +0/min</div>
                </div>
                <div class="bg-slate-900/85 border border-emerald-500/20 rounded-2xl p-2">
                    <div class="text-[9px] font-display text-slate-400 tracking-wider">PLANETAS</div>
                    <div id="startPlanetsCount" class="font-display text-sm sm:text-base font-bold text-emerald-400 mt-0.5">0 / 9</div>
                    <div id="startMiningReadyBadge" class="hidden text-[8px] font-display text-amber-300 animate-pulse mt-0.5">+0 💎 PRONTO</div>
                </div>
            </div>

            <!-- Seletor de Modo de Jogo: Campanha, Setor Abissal & Boss Rush -->
            <div class="grid grid-cols-3 gap-1.5 mb-2 bg-slate-900/90 p-1.5 rounded-2xl border border-slate-800">
                <button type="button" id="btnModeCampaign" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-cyan-500/25 border border-cyan-400 text-white cursor-pointer">
                    🪐 CAMPANHA
                </button>
                <button type="button" id="btnModeInfinite" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-slate-950/60 border border-slate-800 text-slate-400 cursor-pointer">
                    ♾️ ABISSAL
                </button>
                <button type="button" id="btnModeBossRush" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-slate-950/60 border border-rose-500/40 text-rose-300 cursor-pointer">
                    ⚔️ BOSS RUSH
                </button>
            </div>

            <!-- Seletor de Protocolo de Risco (Dificuldade) -->
            <div class="grid grid-cols-3 gap-1.5 mb-2.5 bg-slate-900/90 p-1.5 rounded-2xl border border-slate-800">
                <button type="button" id="btnRiskStandard" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-cyan-500/20 border border-cyan-400 text-cyan-200 cursor-pointer">
                    🛡️ PADRÃO (1.0x)
                </button>
                <button type="button" id="btnRiskVeteran" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-slate-950/60 border border-slate-800 text-slate-400 cursor-pointer">
                    ⚔️ VETERANO (1.5x)
                </button>
                <button type="button" id="btnRiskNightmare" class="py-2 px-1.5 rounded-xl font-display text-[9px] font-bold bg-slate-950/60 border border-slate-800 text-slate-400 cursor-pointer">
                    💀 PESADELO (2.5x)
                </button>
            </div>

            <!-- Cartão de Nave, Pintura & Habilidade Ativa -->
            <div class="bg-slate-900/90 border border-cyan-500/30 rounded-2xl p-2.5 mb-3 flex items-center justify-between text-left">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-12 h-12 rounded-xl bg-slate-950 border border-cyan-500/40 flex items-center justify-center shrink-0 overflow-hidden">
                        <canvas id="startShipPreview" width="64" height="64" class="w-11 h-11 ship-float"></canvas>
                    </div>
                    <div class="min-w-0">
                        <div class="text-[9px] font-display text-cyan-400 tracking-wider">ESQUADRÃO ATIVO</div>
                        <div id="startShipName" class="font-display text-xs sm:text-sm font-bold text-white truncate">VALKYRIE MK-I</div>
                        <div id="startAbilityBadge" class="text-[10px] text-cyan-300 truncate">Poder: ⚡ Pulso EMP</div>
                        <div id="startDroneBadge" class="text-[10px] text-purple-300 truncate">Pintura: Ciano Quântico</div>
                    </div>
                </div>
                <button type="button" id="btnOpenHangar" class="btn-cyber px-3.5 py-2.5 rounded-xl font-display text-[10px] sm:text-[11px] tracking-wider uppercase shrink-0 ml-2 cursor-pointer">
                    HANGAR
                </button>
            </div>

            <!-- Botões Principais -->
            <div class="flex flex-col gap-2">
                <button type="button" id="btnStartGame" class="btn-primary-glow w-full py-3.5 rounded-2xl font-display text-sm sm:text-base tracking-wider uppercase cursor-pointer">
                    DECOLAR AGORA
                </button>
                <div class="grid grid-cols-2 gap-2">
                    <button type="button" id="btnOpenCosmicWheel" class="btn-gold-glow w-full py-3 rounded-2xl font-display text-[10px] sm:text-xs tracking-wider uppercase cursor-pointer">
                        🎰 ROLETA CÓSMICA
                    </button>
                    <button type="button" id="btnOpenWorkshop" class="btn-cyber w-full py-3 rounded-2xl font-display text-[10px] sm:text-xs tracking-wider uppercase cursor-pointer">
                        ⚙️ OFICINA & DRONES
                    </button>
                </div>
                <div class="grid grid-cols-3 gap-1.5">
                    <button type="button" id="btnOpenMissions" class="btn-cyber relative w-full py-2.5 rounded-2xl font-display text-[9px] sm:text-[10px] tracking-wider uppercase cursor-pointer">
                        🏆 MISSÕES
                        <span id="missionsBadge" class="hidden absolute -top-1.5 -right-1.5 w-4 h-4 rounded-full bg-amber-400 text-slate-950 font-extrabold text-[9px] flex items-center justify-center shadow">!</span>
                    </button>
                    <button type="button" id="btnOpenCatalog" class="btn-cyber w-full py-2.5 rounded-2xl font-display text-[9px] sm:text-[10px] tracking-wider uppercase cursor-pointer">
                        🪐 PLANETAS
                    </button>
                    <button type="button" id="btnOpenTrials" class="btn-cyber relative w-full py-2.5 rounded-2xl font-display text-[9px] sm:text-[10px] tracking-wider uppercase border-rose-400/50 text-rose-200 cursor-pointer">
                        🔥 PROVAS (<span id="trialsHeaderCount">0/4</span>)
                    </button>
                </div>
            </div>

            <!-- Opção discreta de recuperação de dados em cache -->
            <div class="mt-3 pt-2 border-t border-slate-800/70 flex items-center justify-between text-[10px] text-slate-500">
                <span>Controles: Arraste na tela para pilotar</span>
                <button type="button" id="btnResetSaveData" class="text-slate-400 hover:text-rose-400 underline cursor-pointer py-1 px-1">
