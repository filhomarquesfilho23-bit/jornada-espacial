        function drawObstacle(obs) {
            ctx.save();
            ctx.translate(obs.x, obs.y);

            if (obs.type === 'elite_cruiser') {
                if (obs.frontShield > 0) {
                    ctx.strokeStyle = '#00ffff';
                    ctx.lineWidth = 3;
                    ctx.shadowColor = '#00ffff';
                    ctx.shadowBlur = 10;
                    ctx.beginPath();
                    ctx.arc(0, 0, obs.radius + 7, 0.15 * Math.PI, 0.85 * Math.PI);
                    ctx.stroke();
                    ctx.shadowBlur = 0;
                }

                ctx.fillStyle = '#1e1b4b';
                ctx.strokeStyle = '#f43f5e';
                ctx.lineWidth = 2.5;
                ctx.shadowColor = '#f43f5e';
                ctx.shadowBlur = 10;

                ctx.beginPath();
                ctx.moveTo(0, obs.radius * 1.15);
                ctx.lineTo(obs.radius * 1.3, -obs.radius * 0.25);
                ctx.lineTo(obs.radius * 0.75, -obs.radius * 0.95);
                ctx.lineTo(-obs.radius * 0.75, -obs.radius * 0.95);
                ctx.lineTo(-obs.radius * 1.3, -obs.radius * 0.25);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = '#fde047';
                ctx.beginPath();
                ctx.arc(0, 0, obs.radius * 0.35, 0, Math.PI * 2);
                ctx.fill();
            } else if (obs.type === 'pirate') {
                ctx.fillStyle = '#3b0712';
                ctx.strokeStyle = '#ff3b5c';
                ctx.lineWidth = 2;
                ctx.shadowColor = '#ff3b5c';
                ctx.shadowBlur = 8;

                ctx.beginPath();
                ctx.moveTo(0, obs.radius * 1.1);
                ctx.lineTo(obs.radius * 1.15, -obs.radius * 0.7);
                ctx.lineTo(0, -obs.radius * 0.35);
                ctx.lineTo(-obs.radius * 1.15, -obs.radius * 0.7);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = '#fb7185';
                ctx.beginPath();
                ctx.arc(0, 0, obs.radius * 0.28, 0, Math.PI * 2);
                ctx.fill();
            } else if (obs.type === 'mine') {
                ctx.rotate(obs.rotation);
                ctx.fillStyle = '#1e1b2e';
                ctx.strokeStyle = '#f43f5e';
                ctx.lineWidth = 2;
                for (let s = 0; s < 8; s++) {
                    const a = (s / 8) * Math.PI * 2;
                    ctx.beginPath();
                    ctx.moveTo(Math.cos(a) * obs.radius * 0.7, Math.sin(a) * obs.radius * 0.7);
                    ctx.lineTo(Math.cos(a) * obs.radius * 1.25, Math.sin(a) * obs.radius * 1.25);
                    ctx.stroke();
                }
                ctx.beginPath();
                ctx.arc(0, 0, obs.radius * 0.78, 0, Math.PI * 2);
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = Math.sin(performance.now() * 0.015) > 0 ? '#ff3b5c' : '#fde047';
                ctx.beginPath();
                ctx.arc(0, 0, obs.radius * 0.32, 0, Math.PI * 2);
                ctx.fill();
            } else if (obs.type === 'drone') {
                ctx.rotate(obs.rotation);
                ctx.fillStyle = '#1e1b4b';
                ctx.strokeStyle = '#f43f5e';
                ctx.lineWidth = 2;
                ctx.beginPath();
                ctx.moveTo(0, -obs.radius);
                ctx.lineTo(obs.radius, 0);
                ctx.lineTo(0, obs.radius);
                ctx.lineTo(-obs.radius, 0);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = '#fb7185';
                ctx.beginPath();
                ctx.arc(0, 0, obs.radius * 0.35, 0, Math.PI * 2);
                ctx.fill();
            } else {
                ctx.rotate(obs.rotation);
                ctx.fillStyle = obs.isShower ? '#451a03' : '#334155';
                ctx.strokeStyle = obs.isShower ? '#fb923c' : '#64748b';
                ctx.lineWidth = 2;

                ctx.beginPath();
                obs.vertices.forEach((v, idx) => {
                    const px = Math.cos(v.angle) * obs.radius * v.dist;
                    const py = Math.sin(v.angle) * obs.radius * v.dist;
                    if (idx === 0) ctx.moveTo(px, py);
                    else ctx.lineTo(px, py);
                });
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.fillStyle = 'rgba(15, 23, 42, 0.5)';
                ctx.beginPath();
                ctx.arc(-obs.radius * 0.25, -obs.radius * 0.2, obs.radius * 0.22, 0, Math.PI * 2);
                ctx.fill();
            }

            ctx.restore();
        }

        function drawBoss(boss) {
            ctx.save();
            ctx.translate(boss.x, boss.y);

            if (boss.laserWarning > 0) {
                const alpha = Math.min(0.85, (1.2 - boss.laserWarning) * 0.8);
                ctx.strokeStyle = `rgba(96, 165, 250, ${alpha})`;
                ctx.lineWidth = 3;
                ctx.setLineDash([8, 6]);
                ctx.beginPath();
                ctx.moveTo(0, boss.radius * 0.8);
                ctx.lineTo(0, height);
                ctx.stroke();
                ctx.setLineDash([]);
            }

            if (boss.laserFiring > 0) {
                const beamGrad = ctx.createLinearGradient(-22, 0, 22, 0);
                beamGrad.addColorStop(0, 'rgba(56, 189, 248, 0)');
                beamGrad.addColorStop(0.5, 'rgba(224, 242, 254, 0.95)');
                beamGrad.addColorStop(1, 'rgba(56, 189, 248, 0)');
                ctx.fillStyle = beamGrad;
                ctx.fillRect(-22, boss.radius * 0.7, 44, height);
            }

            const pulse = 1 + Math.sin(performance.now() * 0.008) * 0.08;
            const aura = ctx.createRadialGradient(0, 0, boss.radius * 0.3, 0, 0, boss.radius * 1.55 * pulse);
            aura.addColorStop(0, boss.auraColor || 'rgba(255, 59, 92, 0.45)');
            aura.addColorStop(1, 'rgba(255, 59, 92, 0)');
            ctx.fillStyle = aura;
            ctx.beginPath();
            ctx.arc(0, 0, boss.radius * 1.55 * pulse, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = boss.bodyColor || '#1e1b4b';
            ctx.strokeStyle = boss.accentColor || '#ff3b5c';
            ctx.lineWidth = 3;
            ctx.shadowColor = boss.accentColor || '#ff3b5c';
            ctx.shadowBlur = 16;

            ctx.beginPath();
            ctx.moveTo(0, boss.radius * 0.95);
            ctx.lineTo(boss.radius * 1.35, 0);
            ctx.lineTo(boss.radius * 0.85, -boss.radius * 0.85);
            ctx.lineTo(-boss.radius * 0.85, -boss.radius * 0.85);
            ctx.lineTo(-boss.radius * 1.35, 0);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.shadowBlur = 0;

            ctx.fillStyle = '#fde047';
            ctx.beginPath();
            ctx.arc(0, 0, boss.radius * 0.32, 0, Math.PI * 2);
            ctx.fill();

            ctx.restore();
        }

        function drawCollectible(c) {
            ctx.save();
            ctx.translate(c.x, c.y);
            const pulse = 1 + Math.sin(c.phase) * 0.14;
            ctx.scale(pulse, pulse);

            const colorMap = {
                energy: { glow: 'rgba(0, 255, 255, 0.55)', main: '#00ffff', inner: '#ffffff' },
                crystal: { glow: 'rgba(250, 204, 21, 0.6)', main: '#facc15', inner: '#fef08a' },
                multishot: { glow: 'rgba(56, 189, 248, 0.65)', main: '#38bdf8', inner: '#ffffff' },
                magnet: { glow: 'rgba(192, 132, 252, 0.65)', main: '#c084fc', inner: '#f3e8ff' },
                overdrive: { glow: 'rgba(251, 146, 60, 0.65)', main: '#fb923c', inner: '#ffedd5' },
                wingman_reinforce: { glow: 'rgba(16, 185, 129, 0.70)', main: '#10b981', inner: '#ffffff' }
            };
            const palette = colorMap[c.kind] || colorMap.energy;

            const glow = ctx.createRadialGradient(0, 0, 2, 0, 0, c.radius * 1.9);
            glow.addColorStop(0, palette.glow);
            glow.addColorStop(1, 'rgba(0, 0, 0, 0)');
            ctx.fillStyle = glow;
            ctx.beginPath();
            ctx.arc(0, 0, c.radius * 1.9, 0, Math.PI * 2);
            ctx.fill();

            ctx.fillStyle = palette.main;
            ctx.strokeStyle = '#ffffff';
            ctx.lineWidth = 1.5;

            ctx.beginPath();
            ctx.moveTo(0, -c.radius);
            ctx.lineTo(c.radius * 0.85, 0);
            ctx.lineTo(0, c.radius);
            ctx.lineTo(-c.radius * 0.85, 0);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();

            ctx.fillStyle = palette.inner;
            ctx.font = 'bold 10px Orbitron';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            const symbol = c.kind === 'multishot' ? 'W'
                : c.kind === 'magnet' ? 'M'
                : c.kind === 'overdrive' ? 'F'
                : c.kind === 'wingman_reinforce' ? '✈'
                : '';
            if (symbol) ctx.fillText(symbol, 0, 0.5);

            ctx.restore();
        }

