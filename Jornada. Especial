                const flashColor = isOverdrive ? '#fde047' : skin.accentColor;
                const flashGrad = targetContext.createRadialGradient(0, -radius * 1.35, 1, 0, -radius * 1.35, radius * 0.95);
                flashGrad.addColorStop(0, '#ffffff');
                flashGrad.addColorStop(0.45, flashColor);
                flashGrad.addColorStop(1, 'rgba(0, 255, 255, 0)');
                targetContext.fillStyle = flashGrad;
                targetContext.beginPath();
                targetContext.arc(0, -radius * 1.35, radius * 0.95, 0, Math.PI * 2);
                targetContext.fill();
            }

            if (isOverdrive) {
                const auraGrad = targetContext.createRadialGradient(0, 0, radius * 0.5, 0, 0, radius * 2.1);
                auraGrad.addColorStop(0, 'rgba(250, 204, 21, 0.45)');
                auraGrad.addColorStop(0.55, `rgba(${skin.shieldRgb}, 0.28)`);
                auraGrad.addColorStop(1, 'rgba(0, 255, 255, 0)');
                targetContext.fillStyle = auraGrad;
                targetContext.beginPath();
                targetContext.arc(0, 0, radius * 2.1, 0, Math.PI * 2);
                targetContext.fill();
            }

            if (!customShip && !isOverdrive && player.invulnerable > 0 && Math.floor(player.invulnerable * 16) % 2 === 0) {
                targetContext.globalAlpha = 0.62;
            }

            if (!customShip) player.thrusterPhase += 0.35;
            const phase = customShip ? previewPhase : player.thrusterPhase;
            const flameLen = (customShip ? 12 : isOverdrive ? 28 : 18) + Math.sin(phase) * 4.5;
            const flameGrad = targetContext.createLinearGradient(0, radius * 0.6, 0, radius * 0.6 + flameLen);
            flameGrad.addColorStop(0, '#ffffff');
            flameGrad.addColorStop(0.4, isOverdrive ? '#fde047' : skin.accentColor);
            flameGrad.addColorStop(1, 'rgba(0, 153, 255, 0)');

            targetContext.fillStyle = flameGrad;
            targetContext.beginPath();
            targetContext.moveTo(-radius * 0.38, radius * 0.62);
            targetContext.lineTo(0, radius * 0.62 + flameLen);
            targetContext.lineTo(radius * 0.38, radius * 0.62);
            targetContext.closePath();
            targetContext.fill();

            targetContext.fillStyle = '#0f172a';
            targetContext.strokeStyle = isOverdrive ? '#fde047' : skin.primaryColor;
            targetContext.lineWidth = customShip ? 1.8 : 2.3;
            targetContext.shadowColor = isOverdrive ? '#fde047' : skin.primaryColor;
            targetContext.shadowBlur = isOverdrive ? 18 : customShip ? 8 : 10;

            targetContext.beginPath();
            if (ship.id === 'spectre') {
                targetContext.moveTo(0, -radius * 1.3);
                targetContext.lineTo(radius * 1.25, radius * 0.55);
                targetContext.lineTo(radius * 0.55, radius * 0.85);
                targetContext.lineTo(0, radius * 0.55);
                targetContext.lineTo(-radius * 0.55, radius * 0.85);
                targetContext.lineTo(-radius * 1.25, radius * 0.55);
            } else if (ship.id === 'titan') {
                targetContext.moveTo(0, -radius * 1.05);
                targetContext.lineTo(radius * 1.25, radius * 0.25);
                targetContext.lineTo(radius * 1.05, radius * 0.85);
                targetContext.lineTo(0, radius * 0.75);
                targetContext.lineTo(-radius * 1.05, radius * 0.85);
                targetContext.lineTo(-radius * 1.25, radius * 0.25);
            } else {
                targetContext.moveTo(0, -radius * 1.15);
                targetContext.lineTo(radius * 1.15, radius * 0.75);
                targetContext.lineTo(radius * 0.45, radius * 0.55);
                targetContext.lineTo(0, radius * 0.8);
                targetContext.lineTo(-radius * 0.45, radius * 0.55);
                targetContext.lineTo(-radius * 1.15, radius * 0.75);
            }
            targetContext.closePath();
            targetContext.fill();
            targetContext.stroke();
            targetContext.shadowBlur = 0;

            const hullGrad = targetContext.createLinearGradient(0, -radius * 1.2, 0, radius * 0.8);
            hullGrad.addColorStop(0, skin.hullColors[0]);
            hullGrad.addColorStop(0.5, skin.hullColors[1]);
            hullGrad.addColorStop(1, skin.hullColors[2]);
            targetContext.fillStyle = hullGrad;

            targetContext.beginPath();
            targetContext.moveTo(0, -radius * 1.25);
            targetContext.lineTo(radius * (ship.id === 'titan' ? 0.52 : 0.42), radius * 0.6);
            targetContext.lineTo(-radius * (ship.id === 'titan' ? 0.52 : 0.42), radius * 0.6);
            targetContext.closePath();
            targetContext.fill();

            targetContext.fillStyle = isOverdrive ? '#fde047' : skin.accentColor;
            targetContext.shadowColor = isOverdrive ? '#fde047' : skin.accentColor;
            targetContext.shadowBlur = 10;
            targetContext.beginPath();
            targetContext.ellipse(0, -radius * 0.15, radius * 0.18, radius * 0.42, 0, 0, Math.PI * 2);
            targetContext.fill();
            targetContext.shadowBlur = 0;

            if (!customShip && player.shield > 0) {
                targetContext.strokeStyle = isOverdrive
                    ? 'rgba(250, 204, 21, 0.85)'
                    : centauriShieldCharges > 0
                        ? 'rgba(253, 224, 71, 0.78)'
                        : activePowerups.magnet > 0
                            ? 'rgba(168, 85, 247, 0.55)'
                            : `rgba(${skin.shieldRgb}, ${0.22 + (player.shield / player.maxShield) * 0.28})`;
                targetContext.lineWidth = isOverdrive || centauriShieldCharges > 0 ? 3 : activePowerups.magnet > 0 ? 2.5 : 1.6;
                targetContext.beginPath();
                targetContext.arc(0, 0, radius * 1.44, 0, Math.PI * 2);
                targetContext.stroke();
            }

            targetContext.restore();
        }

        function drawBlackHole(bh) {
            ctx.save();
            ctx.translate(bh.x, bh.y);

