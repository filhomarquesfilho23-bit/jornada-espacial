        function getPendingMiningCrystals() {
            const ratePerMin = getTotalMiningRatePerMin();
            if (ratePerMin <= 0) return 0;
            const now = Date.now();
            const last = saveData.lastMiningTimestamp || now;
            const elapsedMin = Math.max(0, (now - last) / 60000);
            const cappedMin = Math.min(720, elapsedMin);
            return Math.floor(cappedMin * ratePerMin);
        }

        function collectAllMiningCrystals(silent = false) {
            const pending = getPendingMiningCrystals();
            if (pending <= 0) {
                if (!silent) showToast('Nenhum cristal minerado pronto para coleta ainda.');
                return 0;
            }
            saveData.crystals += pending;
            saveData.lastMiningTimestamp = Date.now();
            writeSaveData(saveData);
