        // 2. MOTOR DE ÁUDIO & TRILHA SONORA SINTETIZADA (NÃO-BLOQUEANTE)
        // ==========================================
        class SpaceAudio {
            constructor() {
                this.ctx = null;
                this.muted = false;
                this.bgmTimer = null;
                this.bgmStep = 0;
            }
            init() {
                try {
                    if (!this.ctx) {
                        const AudioCtx = window.AudioContext || window.webkitAudioContext;
                        if (AudioCtx) {
                            this.ctx = new AudioCtx();
                        }
                    }
                    if (this.ctx && this.ctx.state === 'suspended') {
                        this.ctx.resume().catch(() => {});
                    }
                } catch (e) {}
            }
            toggleMute() {
                this.muted = !this.muted;
                return this.muted;
            }
            startMusic() {
                this.init();
                if (this.bgmTimer) return;
                const bassNotes = [55, 55, 65.41, 49.0, 55, 55, 73.42, 65.41];
                const leadNotes = [220, 261.63, 329.63, 293.66, 392.0, 329.63, 261.63, 196.0];
                this.bgmTimer = setInterval(() => {
                    try {
                        if (this.muted || !this.ctx || this.ctx.state !== 'running' || gameState !== 'PLAYING') return;
                        const now = this.ctx.currentTime;
                        const step = this.bgmStep % 8;
                        const isBossOrOverdrive = Boolean(activeBoss) || overdriveActiveTimer > 0;

                        const bassOsc = this.ctx.createOscillator();
                        const bassGain = this.ctx.createGain();
                        bassOsc.type = isBossOrOverdrive ? 'sawtooth' : 'triangle';
                        bassOsc.frequency.setValueAtTime(bassNotes[step] * (isBossOrOverdrive ? 1.12 : 1), now);
                        bassGain.gain.setValueAtTime(0.03, now);
                        bassGain.gain.exponentialRampToValueAtTime(0.001, now + 0.32);
                        bassOsc.connect(bassGain);
                        bassGain.connect(this.ctx.destination);
                        bassOsc.start(now);
                        bassOsc.stop(now + 0.33);

                        if (step % 2 === 0 || isBossOrOverdrive) {
                            const padOsc = this.ctx.createOscillator();
                            const padGain = this.ctx.createGain();
                            padOsc.type = 'sine';
                            padOsc.frequency.setValueAtTime(leadNotes[step] * (overdriveActiveTimer > 0 ? 1.5 : 1), now);
                            padGain.gain.setValueAtTime(0.016, now);
                            padGain.gain.exponentialRampToValueAtTime(0.0008, now + 0.38);
                            padOsc.connect(padGain);
                            padGain.connect(this.ctx.destination);
                            padOsc.start(now);
                            padOsc.stop(now + 0.4);
                        }
                        this.bgmStep++;
                    } catch (e) {}
                }, 380);
            }
            stopMusic() {
                if (this.bgmTimer) {
                    clearInterval(this.bgmTimer);
                    this.bgmTimer = null;
                }
            }
            playLaser(isDrone = false) {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = isDrone ? 'sine' : 'sawtooth';
                    osc.frequency.setValueAtTime(isDrone ? 980 : 760, now);
                    osc.frequency.exponentialRampToValueAtTime(isDrone ? 340 : 190, now + 0.085);
                    gain.gain.setValueAtTime(isDrone ? 0.025 : 0.045, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.09);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.095);
                } catch (e) {}
            }
            playExplosion(large = false) {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const now = this.ctx.currentTime;
                    const dur = large ? 0.45 : 0.22;
                    const bufferSize = Math.floor(this.ctx.sampleRate * dur);
                    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.32));
                    }
                    const noise = this.ctx.createBufferSource();
                    noise.buffer = buffer;

                    const filter = this.ctx.createBiquadFilter();
                    filter.type = 'lowpass';
                    filter.frequency.setValueAtTime(large ? 360 : 520, now);

                    const gain = this.ctx.createGain();
                    gain.gain.setValueAtTime(large ? 0.22 : 0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + dur);

                    noise.connect(filter);
                    filter.connect(gain);
                    gain.connect(this.ctx.destination);
                    noise.start(now);
                } catch (e) {}
            }
            playPickup(type = 'energy') {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type === 'powerup' ? 'triangle' : 'sine';
                    const startFreq = type === 'crystal' ? 660 : type === 'powerup' ? 580 : 520;
                    const endFreq = type === 'crystal' ? 1320 : type === 'powerup' ? 1180 : 960;
                    osc.frequency.setValueAtTime(startFreq, now);
                    osc.frequency.setValueAtTime(endFreq, now + 0.07);
                    gain.gain.setValueAtTime(0.09, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.19);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.2);
                } catch (e) {}
            }
            playWarp() {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const now = this.ctx.currentTime;
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(220, now);
                    osc.frequency.exponentialRampToValueAtTime(1450, now + 0.35);
                    gain.gain.setValueAtTime(0.14, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.38);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start(now);
                    osc.stop(now + 0.4);
                } catch (e) {}
            }
            playPlanetScan() {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const notes = [440, 554.37, 659.25, 880];
                    notes.forEach((freq, idx) => {
                        const now = this.ctx.currentTime + idx * 0.09;
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, now);
                        gain.gain.setValueAtTime(0.09, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.25);
                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start(now);
                        osc.stop(now + 0.26);
                    });
                } catch (e) {}
            }
            playLevelUp() {
                try {
                    if (this.muted || !this.ctx || this.ctx.state !== 'running') return;
                    const notes = [523.25, 659.25, 783.99, 1046.5];
                    notes.forEach((freq, idx) => {
                        const now = this.ctx.currentTime + idx * 0.06;
                        const osc = this.ctx.createOscillator();
                        const gain = this.ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, now);
                        gain.gain.setValueAtTime(0.08, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.2);
                        osc.connect(gain);
                        gain.connect(this.ctx.destination);
                        osc.start(now);
                        osc.stop(now + 0.22);
                    });
                } catch (e) {}
            }
        }
