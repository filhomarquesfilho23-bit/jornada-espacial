        document.getElementById('btnStartGame').addEventListener('click', startNewGame);
        document.getElementById('btnRestartGame').addEventListener('click', startNewGame);
        document.getElementById('btn-skill').addEventListener('click', triggerActiveAbility);
        document.getElementById('btnShareScore').addEventListener('click', () => shareScoreText());

        document.getElementById('btnSharePilotCard').addEventListener('click', () => {
            const rank = getPilotRankInfo().title;
            const totalKm = (saveData.stats.totalDistanceKm || 0).toLocaleString('pt-BR');
            shareScoreText(`🎖️ Alcancei a patente ${rank} no Jornada Espacial com ${totalKm} km acumulados e ${saveData.visitedPlanets.length}/9 mundos descobertos!`);
        });

        document.getElementById('btn-mute').addEventListener('click', () => {
            audio.init();
            const isMuted = audio.toggleMute();
            document.getElementById('btn-mute').textContent = isMuted ? '🔇' : '🔊';
            showToast(isMuted ? 'Áudio silenciado' : 'Áudio ativado');
        });

        document.getElementById('btn-pause').addEventListener('click', pauseGame);
        document.getElementById('btnResumeGame').addEventListener('click', resumeGame);
        document.getElementById('btnPauseToggleAudio').addEventListener('click', () => {
            audio.init();
            const isMuted = audio.toggleMute();
            document.getElementById('btn-mute').textContent = isMuted ? '🔇' : '🔊';
            document.getElementById('btnPauseToggleAudio').textContent = isMuted ? '🔇 ÁUDIO SILENCIADO' : '🔊 ÁUDIO ATIVADO';
        });
        document.getElementById('btnAbortToMenu').addEventListener('click', () => {
            document.getElementById('pause-screen').classList.add('hidden');
            triggerGameOver('EXPEDIÇÃO ENCERRADA', 'Telemetria e cristais coletados foram salvos na base.');
        });

        document.getElementById('btnContinueJourney').addEventListener('click', () => {
            document.getElementById('planetModal').classList.add('hidden');
            planetApproaching = false;
            approachingPlanet = null;
            bossDefeatedForCurrentPlanet = false;

            if (currentPlanetIndex >= PLANETS_DATA.length - 1) {
                triggerGameOver(
                    'EXPEDIÇÃO CONCLUÍDA!',
                    'Você alcançou Próxima Centauri b e liberou o Setor Abissal no menu principal!',
                    true
                );
            } else {
                currentPlanetIndex++;
                segmentDistance = 0;
                player.invulnerable = 1.5;
                gameState = 'PLAYING';
            }
        });

        document.getElementById('btnBackToMenu').addEventListener('click', () => {
            audio.stopMusic();
            document.getElementById('gameover-screen').classList.add('hidden');
            document.getElementById('menu-screen').classList.remove('hidden');
            setBottomBannerVisible(true);
            refreshStartScreenStats();
            gameState = 'START';
        });

        // Modais: Hangar, Oficina, Missões, Provas Extremas, Perfil do Piloto & Catálogo
        document.getElementById('btnOpenHangar').addEventListener('click', () => {
            audio.init();
            renderHangar();
            document.getElementById('hangarModal').classList.remove('hidden');
        });
        document.getElementById('btnCloseHangar').addEventListener('click', () => {
            document.getElementById('hangarModal').classList.add('hidden');
        });
        document.getElementById('btnCloseHangarBottom').addEventListener('click', () => {
            document.getElementById('hangarModal').classList.add('hidden');
        });

        document.getElementById('btnOpenWorkshop').addEventListener('click', () => {
            audio.init();
            renderWorkshop();
            document.getElementById('workshopModal').classList.remove('hidden');
        });
        document.getElementById('btnCloseWorkshop').addEventListener('click', () => {
            document.getElementById('workshopModal').classList.add('hidden');
        });
        document.getElementById('btnCloseWorkshopBottom').addEventListener('click', () => {
            document.getElementById('workshopModal').classList.add('hidden');
        });

        document.getElementById('btnOpenMissions').addEventListener('click', () => {
            audio.init();
            renderMissions();
            document.getElementById('missionsModal').classList.remove('hidden');
        });
        document.getElementById('btnCloseMissions').addEventListener('click', () => {
            document.getElementById('missionsModal').classList.add('hidden');
        });
        document.getElementById('btnCloseMissionsBottom').addEventListener('click', () => {
            document.getElementById('missionsModal').classList.add('hidden');
        });

        document.getElementById('btnOpenTrials').addEventListener('click', () => {
            audio.init();
            renderExtremeTrials();
            document.getElementById('trialsModal').classList.remove('hidden');
        });
        document.getElementById('btnCloseTrials').addEventListener('click', () => {
            document.getElementById('trialsModal').classList.add('hidden');
        });
        document.getElementById('btnCloseTrialsBottom').addEventListener('click', () => {
            document.getElementById('trialsModal').classList.add('hidden');
        });

        document.getElementById('btnOpenPilotProfile').addEventListener('click', () => {
            audio.init();
            renderPilotProfile();
            document.getElementById('pilotProfileModal').classList.remove('hidden');
        });
        document.getElementById('btnClosePilotProfile').addEventListener('click', () => {
            document.getElementById('pilotProfileModal').classList.add('hidden');
        });
        document.getElementById('btnClosePilotProfileBottom').addEventListener('click', () => {
            document.getElementById('pilotProfileModal').classList.add('hidden');
        });

        document.getElementById('btnOpenCatalog').addEventListener('click', () => {
            audio.init();
            renderCatalog();
            document.getElementById('catalogModal').classList.remove('hidden');
        });
        document.getElementById('btnCloseCatalog').addEventListener('click', () => {
            document.getElementById('catalogModal').classList.add('hidden');
        });
        document.getElementById('btnCloseCatalogBottom').addEventListener('click', () => {
            document.getElementById('catalogModal').classList.add('hidden');
        });

        // Inicialização Segura (Executa imediatamente e revalida no load)
        function initApp() {
            try {
                resizeCanvas();
                initStars();
                refreshStartScreenStats();
                setBottomBannerVisible(true);
                render();
                setInterval(() => {
                    if (gameState === 'START') {
                        refreshStartScreenStats();
                    }
                }, 15000);
                requestAnimationFrame(gameLoop);
            } catch (err) {
                console.error('Erro na inicialização:', err);
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initApp);
        } else {
            initApp();
        }
        window.addEventListener('load', () => {
            resizeCanvas();
            if (stars.length === 0) initStars();
            render();
        });
    </script>

