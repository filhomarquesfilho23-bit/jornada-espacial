                : activeRunMode === 'INFINITE'
                    ? 'SETOR ABISSAL'
                    : 'CAMPANHA';
            document.getElementById('pauseModeText').textContent = `${modeLabel} • ${activeRunRisk.name.toUpperCase()}`;
            document.getElementById('pauseShipName').textContent = `${getActiveShip().name} (${getActiveAbility().name})`;
            document.getElementById('pauseScoreText').textContent = Math.floor(score).toLocaleString('pt-BR');
            document.getElementById('pauseCrystalsText').textContent = `+${runCrystals} 💎`;
            document.getElementById('btnPauseToggleAudio').textContent = audio.muted ? '🔇 ÁUDIO SILENCIADO' : '🔊 ÁUDIO ATIVADO';
            document.getElementById('pause-screen').classList.remove('hidden');
        }

        function resumeGame() {
            if (gameState !== 'PAUSED') return;
            document.getElementById('pause-screen').classList.add('hidden');
            gameState = 'PLAYING';
        }

        function applyPlayerDamage(rawDmg, causeTitle, causeSubtitle, explosionColor = '#ff3b5c') {
            const finalDmg = Math.round(rawDmg * activeRunRisk.damageMult);
            player.shield -= finalDmg;
            comboCount = 1;
            comboTimer = 0;

            if (activeBounty && activeBounty.type === 'nodamage') {
                activeBounty.progress = 0;
                showToast('⚠️ Dano sofrido! Cronômetro do Bounty reiniciado.');
            }

            audio.playExplosion(true);
            triggerHaptic([75, 40, 95]);
            spawnExplosion(player.x, player.y, explosionColor, 20, 9);
            addFloatingText(player.x, player.y - 25, `-${finalDmg} ESCUDO`, '#ff3b5c');

            if (player.shield <= 0) {
                player.shield = 0;
                triggerGameOver(causeTitle, causeSubtitle);
            }
        }

        let obstacleSpawnTimer = 0;
        let collectibleSpawnTimer = 0;
        let warpSpawnTimer = 15;
        let satelliteSpawnTimer = 11;

        function update(dt) {
            const isOverdrive = overdriveActiveTimer > 0;
            const isWarping = isOverdrive || warpDriveBoostTimer > 0;
            const worldSlowFactor = temporalStasisTimer > 0 ? 0.20 : 1.0;

            if (warpDriveBoostTimer > 0) {
                warpDriveBoostTimer = Math.max(0, warpDriveBoostTimer - dt);
            }

            const targetZoom = isWarping ? 1.045 : 1.0;
            cameraWarpZoom += (targetZoom - cameraWarpZoom) * Math.min(1, 5.5 * dt);

            stars.forEach(s => {
                const warpMult = isWarping ? 2.65 : 1.0;
                s.y += (baseSpeed * warpMult * worldSlowFactor) * s.speedMult * dt;
                if (s.y > height) {
                    s.y = -4;
                    s.x = Math.random() * width;
                }
            });

            if (shakeIntensity > 0) {
                shakeIntensity = Math.max(0, shakeIntensity - 28 * dt);
            }

            if (gameState !== 'PLAYING') return;

            const ship = getActiveShip();
            const skin = getActiveSkin();
            const activeDrone = getActiveDrone();
            const plasmaLvl = saveData.upgrades.plasma;
            const magnetLvl = saveData.upgrades.magnet;
            const baseProjectileDamage = (1 + plasmaLvl * 0.22) * (isOverdrive ? 1.5 : 1);

            if (player.muzzleFlash > 0) {
                player.muzzleFlash = Math.max(0, player.muzzleFlash - dt);
            }

            if (hasRelic('jupiter_heart') && player.shield < player.maxShield) {
                heartRegenTimer += dt;
                if (heartRegenTimer >= 4.0) {
                    heartRegenTimer = 0;
                    player.shield = Math.min(player.maxShield, player.shield + 1);
                    addFloatingText(player.x, player.y - 24, '+1 HP 🟠', '#fb923c');
                }
            }

            if (runMerchantBuffs.orbitalSphere) {
                orbitalSphereAngle += 4.6 * dt;
                const orbitR = player.radius + 36;
                const sx = player.x + Math.cos(orbitalSphereAngle) * orbitR;
                const sy = player.y + Math.sin(orbitalSphereAngle) * orbitR;

                enemyLasers.forEach(el => {
                    if (!el.hit && Math.hypot(el.x - sx, el.y - sy) < 16 + el.radius) {
                        el.hit = true;
                        spawnExplosion(sx, sy, '#e879f9', 6);
                    }
                });

                obstacles.forEach(obs => {
                    if (obs.hp > 0 && Math.hypot(obs.x - sx, obs.y - sy) < obs.radius + 14) {
                        obs.hp -= 12 * dt;
                        if (obs.hp <= 0) {
                            audio.playExplosion(false);
                            triggerHaptic(22);
                            spawnExplosion(obs.x, obs.y, '#e879f9', 14);
                            if (obs.type === 'asteroid') saveData.stats.asteroidsDestroyed++;
                            else saveData.stats.enemiesDefeated++;
                            const pts = registerKillCombo(60, 8);
                            addFloatingText(obs.x, obs.y, `+${pts}`, '#e879f9');
                        }
                    }
                });
            }

            if (comboTimer > 0) {
                comboTimer -= dt;
                if (comboTimer <= 0) comboCount = 1;
            }
            if (overdriveActiveTimer > 0) {
                overdriveActiveTimer -= dt;
                if (overdriveActiveTimer <= 0) {
                    overdriveActiveTimer = 0;
                    overdriveCharge = 0;
                }
            }
            if (temporalStasisTimer > 0) {
                temporalStasisTimer = Math.max(0, temporalStasisTimer - dt);
            }
            if (activePowerups.multishot > 0) activePowerups.multishot = Math.max(0, activePowerups.multishot - dt);
            if (activePowerups.magnet > 0) activePowerups.magnet = Math.max(0, activePowerups.magnet - dt);
            if (activePowerups.overdrive > 0) activePowerups.overdrive = Math.max(0, activePowerups.overdrive - dt);
            if (activePowerups.wingman_reinforce > 0) activePowerups.wingman_reinforce = Math.max(0, activePowerups.wingman_reinforce - dt);

            if (abilityCooldown > 0) abilityCooldown = Math.max(0, abilityCooldown - dt);
            if (player.invulnerable > 0) player.invulnerable -= dt;

            if (activeBounty) {
                activeBounty.timer -= dt;
                if (activeBounty.type === 'nodamage') {
                    activeBounty.progress += dt;
                    if (activeBounty.progress >= activeBounty.target) {
                        completeActiveBounty();
                    }
                }
                if (activeBounty && activeBounty.timer <= 0) {
                    showToast('⌛ Tempo do Desafio Relâmpago esgotado.');
                    activeBounty = null;
                }
            }

            const keySpeed = 400;
            if (keys['ArrowLeft'] || keys['KeyA']) player.targetX -= keySpeed * dt;
            if (keys['ArrowRight'] || keys['KeyD']) player.targetX += keySpeed * dt;
            if (keys['ArrowUp'] || keys['KeyW']) player.targetY -= keySpeed * dt;
            if (keys['ArrowDown'] || keys['KeyS']) player.targetY += keySpeed * dt;

            blackHoles.forEach(bh => {
                const dx = bh.x - player.x;
                const dy = bh.y - player.y;
                const dist = Math.hypot(dx, dy);
                if (dist > 5 && dist < bh.pullRadius) {
                    const pullStrength = (1 - dist / bh.pullRadius) * 260 * worldSlowFactor;
                    player.targetX += (dx / dist) * pullStrength * dt;
                    player.targetY += (dy / dist) * pullStrength * dt;
                }
            });

            if (solarStormActive > 0) {
                player.targetX += Math.sin(performance.now() * 0.008) * 140 * dt;
            }

            player.targetX = Math.max(player.radius + 10, Math.min(width - player.radius - 10, player.targetX));
            player.targetY = Math.max(player.radius + 70, Math.min(height - player.radius - 20, player.targetY));

            player.x += (player.targetX - player.x) * ship.speedFactor;
            player.y += (player.targetY - player.y) * ship.speedFactor;

            const activeWingmanCount = activePowerups.wingman_reinforce > 0
                ? 2
                : Math.min(2, saveData.upgrades.wingman || 0);

            while (wingmenShips.length < activeWingmanCount) {
                wingmenShips.push({ x: player.x, y: player.y + 18, phase: Math.random() * Math.PI * 2 });
            }
            if (wingmenShips.length > activeWingmanCount) {
                wingmenShips.length = activeWingmanCount;
            }

            if (activeWingmanCount > 0) {
                const offsets = activeWingmanCount === 1
                    ? [{ dx: -44, dy: 14 }]
                    : [{ dx: -44, dy: 14 }, { dx: 44, dy: 14 }];

                wingmenShips.forEach((wm, idx) => {
                    const off = offsets[idx];
                    const goalX = Math.max(18, Math.min(width - 18, player.x + off.dx));
                    const goalY = Math.max(75, Math.min(height - 20, player.y + off.dy));
                    wm.x += (goalX - wm.x) * Math.min(1, 9.5 * dt);
                    wm.y += (goalY - wm.y) * Math.min(1, 9.5 * dt);
                    wm.phase += 0.35;
                });

                wingmanFireTimer += dt;
                const wmInterval = Math.max(0.18, ship.fireInterval * 1.15);
                if (wingmanFireTimer >= wmInterval) {
                    wingmanFireTimer = 0;
                    wingmenShips.forEach(wm => {
                        lasers.push({
                            x: wm.x,
                            y: wm.y - 14,
                            vx: 0,
                            vy: -760,
                            radius: 3.6,
                            dmg: baseProjectileDamage * 0.55,
                            color: skin.accentColor,
                            piercing: false,
                            hitIds: []
                        });
                    });
                }
            }

            if (activeDrone) {
                droneOrbitAngle += 3.2 * dt;
                if (droneShieldCooldown > 0) droneShieldCooldown = Math.max(0, droneShieldCooldown - dt);
                droneFireTimer += dt;
                if (droneFireTimer >= activeDrone.fireInterval) {
                    droneFireTimer = 0;
                    const orbitDist = player.radius + 26;
                    for (let i = 0; i < activeDrone.count; i++) {
                        const a = droneOrbitAngle + i * Math.PI;
                        const dx = player.x + Math.cos(a) * orbitDist;
                        const dy = player.y + Math.sin(a) * orbitDist;
                        lasers.push({
                            x: dx,
                            y: dy - 8,
                            vx: 0,
                            vy: -770,
                            radius: 3.4,
                            dmg: baseProjectileDamage * 0.65,
                            color: '#38bdf8',
                            piercing: false,
                            hitIds: []
                        });
                    }
                    audio.playLaser(true);
                }
            }

            const rateBonus = Math.pow(0.94, plasmaLvl);
            const baseInterval = ship.fireInterval * rateBonus;
            const effectiveFireInterval = isOverdrive
                ? baseInterval * 0.45
                : activePowerups.overdrive > 0
                    ? baseInterval * 0.55
                    : baseInterval;

            player.fireTimer += dt;
            if (player.fireTimer >= effectiveFireInterval) {
                player.fireTimer = 0;
                firePlayerVolley();
            }

            const currentSpeed = baseSpeed * (isOverdrive ? 1.55 : 1) + currentPlanetIndex * 18;
            const distDelta = (currentSpeed * dt) / 14;
            totalRunDistance += distDelta;
            segmentDistance += distDelta;
            score += distDelta * 12 * comboCount;

            if (!isOverdrive) {
                player.energy -= 2.2 * dt;
                if (player.energy <= 0) {
                    player.energy = 0;
                    triggerGameOver('SEM ENERGIA DE PROPULSÃO', 'A nave ficou à deriva no vácuo. Colete mais cápsulas ciano!');
                    return;
                }
            }

            meteorShowerTimer -= dt;
            if (meteorShowerTimer <= 0 && !activeBoss && !planetApproaching) {
                meteorShowerTimer = 26 + Math.random() * 10;
                meteorShowerActive = 5.5;
                eventBannerTimer = 3.2;
                const banner = document.getElementById('eventAlertBanner');
                banner.textContent = '⚠️ CHUVA DE METEOROS!';
                banner.classList.remove('hidden');
            }
            if (meteorShowerActive > 0) meteorShowerActive -= dt;

            solarStormTimer -= dt;
            if (solarStormTimer <= 0 && !activeBoss && !planetApproaching) {
                solarStormTimer = 34 + Math.random() * 12;
                solarStormActive = 6.0;
                eventBannerTimer = 3.5;
                triggerHaptic([40, 30, 40]);
                const banner = document.getElementById('eventAlertBanner');
                banner.textContent = '☀️ TEMPESTADE SOLAR EMP!';
                banner.classList.remove('hidden');
            }
            if (solarStormActive > 0) solarStormActive -= dt;

            if (eventBannerTimer > 0) {
                eventBannerTimer -= dt;
                if (eventBannerTimer <= 0) {
                    document.getElementById('eventAlertBanner').classList.add('hidden');
                }
            }

            if (!activeBoss && !planetApproaching && totalRunDistance >= nextBlackHoleDistance) {
                nextBlackHoleDistance += 1900;
                blackHoles.push({
                    x: 80 + Math.random() * Math.max(40, width - 160),
                    y: -90,
                    vy: baseSpeed * 0.62,
                    coreRadius: 22,
                    pullRadius: 155,
                    angle: 0
                });
                showToast('🕳️ Singularidade Gravitacional à frente!');
            }

            blackHoles.forEach(bh => {
                bh.y += bh.vy * worldSlowFactor * dt;
                bh.angle += 2.8 * dt;
                if (!isOverdrive && player.invulnerable <= 0 && Math.hypot(player.x - bh.x, player.y - bh.y) < player.radius + bh.coreRadius * 0.85) {
                    player.invulnerable = 1.2;
                    applyPlayerDamage(28, 'ENGOLIDO PELA SINGULARIDADE', 'O horizonte de eventos destruiu o casco da nave.', '#c084fc');
                }
            });
            blackHoles = blackHoles.filter(bh => bh.y < height + 160);

            if (!activeBounty && !activeBoss && !planetApproaching && totalRunDistance >= nextBountyDistance) {
                nextBountyDistance += 2200;
                spawnRandomBounty();
            }

            lasers.forEach(l => {
                l.x += (l.vx || 0) * dt;
                l.y += l.vy * dt;
            });
            lasers = lasers.filter(l => l.y > -30 && l.x > -30 && l.x < width + 30);

            homingMissiles.forEach(m => {
                m.life -= dt;
                let nearest = null;
                let minDist = Infinity;
                if (activeBoss) {
                    nearest = activeBoss;
                    minDist = Math.hypot(activeBoss.x - m.x, activeBoss.y - m.y);
                }
                obstacles.forEach(obs => {
                    if (obs.hp > 0) {
                        const d = Math.hypot(obs.x - m.x, obs.y - m.y);
                        if (d < minDist) {
                            minDist = d;
                            nearest = obs;
                        }
                    }
                });

                if (nearest) {
                    const desiredAngle = Math.atan2(nearest.y - m.y, nearest.x - m.x);
                    m.vx += Math.cos(desiredAngle) * 1450 * dt;
                    m.vy += Math.sin(desiredAngle) * 1450 * dt;
                    const spd = Math.hypot(m.vx, m.vy);
                    if (spd > 560) {
                        m.vx = (m.vx / spd) * 560;
                        m.vy = (m.vy / spd) * 560;
                    }
                }
                m.x += m.vx * dt;
                m.y += m.vy * dt;

                if (activeBoss && Math.hypot(activeBoss.x - m.x, activeBoss.y - m.y) < activeBoss.radius + 12) {
                    activeBoss.hp -= m.dmg;
                    m.life = 0;
                    triggerHaptic(18);
                    spawnExplosion(m.x, m.y, '#fbbf24', 10, 3);
                }

                obstacles.forEach(obs => {
                    if (m.life > 0 && obs.hp > 0 && Math.hypot(obs.x - m.x, obs.y - m.y) < obs.radius + 12) {
                        obs.hp -= m.dmg;
                        m.life = 0;
                        triggerHaptic(18);
                        spawnExplosion(m.x, m.y, '#fbbf24', 10, 3);
                        if (obs.hp <= 0) {
                            audio.playExplosion(false);
                            if (obs.type === 'asteroid') saveData.stats.asteroidsDestroyed++;
                            else saveData.stats.enemiesDefeated++;
                            const pts = registerKillCombo(75, 8);
                            addFloatingText(obs.x, obs.y, `+${pts}`, '#fbbf24');
                        }
                    }
                });
            });
            homingMissiles = homingMissiles.filter(m => m.life > 0 && m.y > -40 && m.y < height + 40);

            enemyLasers.forEach(el => {
                el.x += (el.vx || 0) * worldSlowFactor * dt;
                el.y += el.vy * worldSlowFactor * dt;

                if (!el.hit && activeDrone && activeDrone.hasShieldDeflector && droneShieldCooldown <= 0) {
                    const orbitDist = player.radius + 26;
                    const dx = player.x + Math.cos(droneOrbitAngle) * orbitDist;
                    const dy = player.y + Math.sin(droneOrbitAngle) * orbitDist;
                    if (Math.hypot(el.x - dx, el.y - dy) < 18 + el.radius) {
                        el.hit = true;
                        droneShieldCooldown = 8.0;
                        audio.playPickup('energy');
                        spawnExplosion(dx, dy, '#00ffff', 12);
                        addFloatingText(dx, dy - 12, 'ESCUDO DRONE!', '#00ffff');
                    }
                }

                if (!el.hit && !isOverdrive && player.invulnerable <= 0 && Math.hypot(el.x - player.x, el.y - player.y) < player.radius + el.radius) {
                    el.hit = true;
                    player.invulnerable = 0.85;

                    if (centauriShieldCharges > 0) {
                        centauriShieldCharges--;
                        audio.playPickup('energy');
                        triggerHaptic(25);
                        spawnExplosion(player.x, player.y, '#fde047', 18, 4);
                        addFloatingText(player.x, player.y - 25, '👑 COROA CENTAURI BLOQUEOU!', '#fde047');
                    } else {
                        const dmg = el.dmg || 16;
                        applyPlayerDamage(dmg, 'ABATIDO EM COMBATE', 'Os disparos inimigos perfuraram os escudos da nave.');
                    }
                }
            });
            enemyLasers = enemyLasers.filter(el => !el.hit && el.y < height + 30 && el.x > -30 && el.x < width + 30);

            if (!activeBoss && !planetApproaching && !merchantShip && totalRunDistance >= nextMerchantDistance) {
                nextMerchantDistance += 3500;
                merchantShip = {
                    x: 60 + Math.random() * Math.max(40, width - 120),
                    y: -45,
                    vy: 95,
                    radius: 26,
                    phase: 0
                };
                showToast('🛸 Nave Mercante Dourada detectada no setor!');
            }

            if (merchantShip) {
                merchantShip.phase += 2.5 * dt;
                merchantShip.y += merchantShip.vy * worldSlowFactor * dt;
                merchantShip.x += Math.sin(merchantShip.phase) * 45 * worldSlowFactor * dt;

                if (Math.hypot(player.x - merchantShip.x, player.y - merchantShip.y) < player.radius + merchantShip.radius + 10) {
                    merchantShip = null;
                    openMerchantModal();
                    return;
                } else if (merchantShip.y > height + 60) {
                    merchantShip = null;
                }
            }

            if (activeBoss) {
                if (activeBoss.y < activeBoss.targetY) {
                    activeBoss.y += 120 * dt;
                } else {
                    activeBoss.x += activeBoss.vx * worldSlowFactor * dt;
                    if (activeBoss.x < activeBoss.radius + 25 || activeBoss.x > width - activeBoss.radius - 25) {
                        activeBoss.vx *= -1;
                    }
                }

                if (activeBoss.bossType === 'abyssal_leviathan') {
                    activeBoss.specialCooldown -= worldSlowFactor * dt;
                    if (activeBoss.specialCooldown <= 0 && activeBoss.laserWarning <= 0 && activeBoss.laserFiring <= 0) {
                        activeBoss.laserWarning = 1.2;
                        activeBoss.specialCooldown = 6.5;
                    }
                    if (activeBoss.laserWarning > 0) {
                        activeBoss.laserWarning -= worldSlowFactor * dt;
                        if (activeBoss.laserWarning <= 0) {
                            activeBoss.laserFiring = 1.1;
                            audio.playWarp();
                        }
                    }
                    if (activeBoss.laserFiring > 0) {
                        activeBoss.laserFiring -= worldSlowFactor * dt;
                        if (!isOverdrive && player.invulnerable <= 0 && Math.abs(player.x - activeBoss.x) < 22 + player.radius && player.y > activeBoss.y) {
                            player.invulnerable = 0.9;
                            applyPlayerDamage(26, 'VAPORIZADO PELO FEIXE ABISSAL', 'O raio laser do Leviatã perfurou sua blindagem.', '#38bdf8');
                        }
                    }
                }

                activeBoss.fireTimer -= worldSlowFactor * dt;
                if (activeBoss.fireTimer <= 0) {
                    activeBoss.fireTimer = activeBoss.fireRate;
                    const aimAngle = Math.atan2(player.y - activeBoss.y, player.x - activeBoss.x);
                    const bSpd = (315 + currentPlanetIndex * 12) * activeRunRisk.speedMult;

                    if (activeBoss.bossType === 'ring_archon') {
                        activeBoss.spiralAngle += 0.55;
                        for (let s = 0; s < 4; s++) {
                            const a = activeBoss.spiralAngle + (s * Math.PI) / 2;
                            enemyLasers.push({
                                x: activeBoss.x,
                                y: activeBoss.y,
                                vx: Math.cos(a) * (bSpd * 0.78),
                                vy: Math.sin(a) * (bSpd * 0.78),
                                radius: 5.5,
                                dmg: 16
                            });
                        }
                    } else if (activeBoss.bossType === 'stellar_sovereign') {
                        [-0.3, -0.1, 0.1, 0.3].forEach(spread => {
                            enemyLasers.push({
                                x: activeBoss.x,
                                y: activeBoss.y + activeBoss.radius * 0.5,
                                vx: Math.cos(aimAngle + spread) * bSpd,
                                vy: Math.sin(aimAngle + spread) * bSpd,
                                radius: 6,
                                dmg: 18
                            });
                        });
                    } else {
                        [-0.24, 0, 0.24].forEach(spread => {
                            enemyLasers.push({
                                x: activeBoss.x,
                                y: activeBoss.y + activeBoss.radius * 0.6,
                                vx: Math.cos(aimAngle + spread) * bSpd,
                                vy: Math.sin(aimAngle + spread) * bSpd,
                                radius: 6,
                                dmg: 17
                            });
                        });
                    }
                }

                lasers.forEach((l, lIdx) => {
                    if (activeBoss && Math.hypot(l.x - activeBoss.x, l.y - activeBoss.y) < activeBoss.radius + l.radius) {
                        const hitRes = rollDamageWithCrit(l.dmg);
                        activeBoss.hp -= hitRes.dmg;
                        lasers.splice(lIdx, 1);
                        triggerHaptic(14);
                        spawnExplosion(l.x, l.y, hitRes.isCrit ? '#fde047' : activeBoss.accentColor, hitRes.isCrit ? 8 : 4);
                        if (hitRes.isCrit) {
                            addFloatingText(l.x, l.y - 10, `CRÍTICO! -${Math.round(hitRes.dmg)}`, '#fde047');
                        }
                    }
                });

                if (activeBoss && activeBoss.hp <= 0) {
                    audio.playExplosion(true);
                    triggerHaptic([90, 50, 120]);
                    spawnExplosion(activeBoss.x, activeBoss.y, '#ff3b5c', 45, 16);
                    spawnExplosion(activeBoss.x, activeBoss.y, '#fde047', 30, 12);
                    registerKillCombo(1200, 40);

                    if (!bossUsedAbilityThisFight) {
                        unlockTrial('trial_pacifist_boss');
                    }

                    const relicBonusMult = hasRelic('saturn_ring') ? 1.25 : 1.0;
                    const baseBossCrystals = activeRunMode === 'BOSS_RUSH' ? 35 : activeRunMode === 'INFINITE' ? 50 : 25;
                    const bossCrystalReward = Math.round(baseBossCrystals * relicBonusMult * activeRunRisk.crystalMult);
                    runCrystals += bossCrystalReward;
                    saveData.stats.crystalsCollected += bossCrystalReward;
                    saveData.stats.bossesBeaten += 1;

                    const unlockedRelic = RELICS_DATA.find(r => r.bossType === activeBoss.bossType);
                    if (unlockedRelic && !saveData.unlockedRelics.includes(unlockedRelic.id)) {
                        saveData.unlockedRelics.push(unlockedRelic.id);
                        writeSaveData(saveData);
                        showToast(`🏺 RELÍQUIA DESBLOQUEADA: ${unlockedRelic.icon} ${unlockedRelic.name}!`);
                    }

                    addFloatingText(activeBoss.x, activeBoss.y, `GUARDIÃO DERROTADO! +${bossCrystalReward} 💎`, '#fde047');
                    activeBoss = null;
                    bossDefeatedForCurrentPlanet = true;
                    enemyLasers = [];

                    if (activeRunMode === 'BOSS_RUSH') {
                        bossRushIndex++;
                        const bossPlanets = PLANETS_DATA.filter(p => p.hasBoss);
                        if (bossRushIndex >= bossPlanets.length) {
                            const championBonus = Math.round(120 * activeRunRisk.crystalMult);
                            runCrystals += championBonus;
                            saveData.stats.crystalsCollected += championBonus;
                            saveData.bossRushWins = (saveData.bossRushWins || 0) + 1;
                            lastRunPlanetReached = 'Boss Rush (5/5 Guardiões)';
                            writeSaveData(saveData);
                            triggerGameOver(
                                'CAMPEÃO DO BOSS RUSH!',
                                `Você derrotou todos os 5 Guardiões em sequência e ganhou +${championBonus} 💎 de bônus!`,
                                true
                            );
                            return;
                        } else {
                            player.shield = Math.min(player.maxShield, player.shield + player.maxShield * 0.35);
                            player.energy = player.maxEnergy;
                            spawnCollectible(width / 2, height * 0.28, false);
                            bossRushPauseTimer = 2.0;
                            showToast(`⚔️ Guardião ${bossRushIndex}/5 vencido! +35% Escudo. Próximo chefe em 2s...`);
                        }
                    }
                }
            } else if (activeRunMode === 'BOSS_RUSH') {
                const bossPlanets = PLANETS_DATA.filter(p => p.hasBoss);
                const nextBossPlanet = bossPlanets[bossRushIndex];
                if (nextBossPlanet) {
                    lastRunPlanetReached = `Boss Rush (${bossRushIndex}/5)`;
                    if (bossRushPauseTimer > 0) {
                        bossRushPauseTimer -= dt;
                    } else {
                        bossDefeatedForCurrentPlanet = false;
                        spawnBossForPlanet(nextBossPlanet);
                    }
                }
            } else if (activeRunMode === 'CAMPAIGN') {
                const targetPlanet = PLANETS_DATA[currentPlanetIndex];
                if (targetPlanet && segmentDistance >= targetPlanet.distance) {
                    if (targetPlanet.hasBoss && !bossDefeatedForCurrentPlanet) {
                        spawnBossForPlanet(targetPlanet);
                    } else if (!planetApproaching) {
                        planetApproaching = true;
                        approachingPlanet = {
                            data: targetPlanet,
                            x: width / 2,
                            y: -targetPlanet.radius - 40
                        };
                    }
                }
            } else if (activeRunMode === 'INFINITE') {
                lastRunPlanetReached = `Setor Abissal #${infiniteSectorLevel}`;
                if (segmentDistance >= infiniteSectorGoal) {
                    if (!bossDefeatedForCurrentPlanet) {
                        const randomBossPlanet = PLANETS_DATA.filter(p => p.hasBoss)[infiniteSectorLevel % 5];
                        spawnBossForPlanet(randomBossPlanet);
                    } else {
                        const sectorBonus = Math.round((30 + infiniteSectorLevel * 10) * activeRunRisk.crystalMult);
                        runCrystals += sectorBonus;
                        saveData.stats.crystalsCollected += sectorBonus;
                        player.shield = Math.min(player.maxShield, player.shield + player.maxShield * 0.4);
                        player.energy = player.maxEnergy;
                        audio.playLevelUp();
                        triggerHaptic([40, 30, 60]);
                        addFloatingText(player.x, player.y - 40, `SETOR #${infiniteSectorLevel} CONCLUÍDO! +${sectorBonus} 💎`, '#c084fc');
                        infiniteSectorLevel++;
                        segmentDistance = 0;
                        infiniteSectorGoal = Math.round(infiniteSectorGoal * 1.18);
                        bossDefeatedForCurrentPlanet = false;
                    }
                }
            }

            if (planetApproaching && approachingPlanet) {
                approachingPlanet.y += (baseSpeed * 0.72) * dt;
                if (approachingPlanet.y >= height * 0.34) {
                    triggerPlanetArrival(approachingPlanet.data);
                    return;
                }
            }

            if (!planetApproaching && !activeBoss && activeRunMode !== 'BOSS_RUSH') {
                obstacleSpawnTimer += dt;
                const baseSpawnInt = meteorShowerActive > 0
                    ? 0.24
                    : Math.max(0.32, 0.85 - currentPlanetIndex * 0.055);
                const spawnInterval = baseSpawnInt / activeRunRisk.spawnRateMult;
                if (obstacleSpawnTimer >= spawnInterval) {
                    obstacleSpawnTimer = 0;
                    spawnObstacle(meteorShowerActive > 0);
                }

                collectibleSpawnTimer += dt;
                if (collectibleSpawnTimer >= 1.5) {
                    collectibleSpawnTimer = 0;
                    spawnCollectible();
                }

                warpSpawnTimer -= dt;
                if (warpSpawnTimer <= 0) {
                    warpSpawnTimer = 20 + Math.random() * 10;
                    spawnWarpPortal();
                }

                satelliteSpawnTimer -= dt;
                if (satelliteSpawnTimer <= 0) {
                    satelliteSpawnTimer = 15 + Math.random() * 8;
                    spawnSupplySatellite();
                }
            }

            warpPortals.forEach(wp => {
                wp.y += wp.vy * worldSlowFactor * dt;
                wp.angle += 3.5 * dt;

                if (!wp.used && Math.hypot(player.x - wp.x, player.y - wp.y) < player.radius + wp.radius * 0.85) {
                    wp.used = true;
                    audio.playWarp();
                    triggerHaptic([30, 25, 50]);
                    warpDriveBoostTimer = 2.8;
                    const warpKm = 1500;
                    const warpCrystals = Math.round(15 * activeRunRisk.crystalMult);
                    totalRunDistance += warpKm;
                    segmentDistance += warpKm;
                    runCrystals += warpCrystals;
                    saveData.stats.crystalsCollected += warpCrystals;
                    player.invulnerable = 1.6;
                    spawnExplosion(wp.x, wp.y, '#00ffff', 28, 6);
                    addFloatingText(player.x, player.y - 35, `🌀 SALTO QUÂNTICO! +${warpKm} km • +${warpCrystals} 💎`, '#00ffff');
                }
            });
            warpPortals = warpPortals.filter(wp => !wp.used && wp.y < height + 80);

            supplySatellites.forEach(sat => {
                sat.x += sat.vx * worldSlowFactor * dt;
                sat.y += sat.vy * worldSlowFactor * dt;
                sat.angle += 1.2 * dt;
                if (sat.x < 35 || sat.x > width - 35) sat.vx *= -1;

                for (let lIdx = lasers.length - 1; lIdx >= 0; lIdx--) {
                    const l = lasers[lIdx];
                    if (sat.hp > 0 && Math.hypot(l.x - sat.x, l.y - sat.y) < sat.radius + l.radius) {
                        sat.hp -= l.dmg;
                        lasers.splice(lIdx, 1);
                        triggerHaptic(14);
                        spawnExplosion(l.x, l.y, '#fde047', 5);
                        if (sat.hp <= 0) {
                            audio.playExplosion(false);
                            triggerHaptic([35, 30, 45]);
                            spawnExplosion(sat.x, sat.y, '#fde047', 22, 6);
                            spawnCollectible(sat.x - 16, sat.y, true);
                            spawnCollectible(sat.x + 16, sat.y, false);
                            const pts = registerKillCombo(220, 15);
                            addFloatingText(sat.x, sat.y, `SATÉLITE ABATIDO! +${pts}`, '#fde047');
                        }
                    }
                }
            });
            supplySatellites = supplySatellites.filter(sat => sat.hp > 0 && sat.y < height + 60);

            obstacles.forEach(obs => {
                obs.x += obs.vx * worldSlowFactor * dt;
                obs.y += obs.vy * worldSlowFactor * dt;
                obs.rotation += obs.rotSpeed * worldSlowFactor * dt;

                if (obs.x < obs.radius || obs.x > width - obs.radius) {
                    obs.vx *= -1;
                }

                if ((obs.type === 'pirate' || obs.type === 'elite_cruiser') && obs.y > 40 && obs.y < height * 0.62) {
                    obs.shootTimer -= worldSlowFactor * dt;
                    if (obs.shootTimer <= 0) {
                        obs.shootTimer = obs.type === 'elite_cruiser' ? 1.55 : 1.75;
                        const aim = Math.atan2(player.y - obs.y, player.x - obs.x);
                        const spd = 290 * activeRunRisk.speedMult;
                        if (obs.type === 'elite_cruiser') {
                            [-0.22, 0, 0.22].forEach(sp => {
                                enemyLasers.push({
                                    x: obs.x,
                                    y: obs.y + obs.radius * 0.8,
                                    vx: Math.cos(aim + sp) * spd,
                                    vy: Math.sin(aim + sp) * spd,
                                    radius: 5,
                                    dmg: 16
                                });
                            });
                        } else {
                            enemyLasers.push({
                                x: obs.x,
                                y: obs.y + obs.radius * 0.8,
                                vx: Math.cos(aim) * spd,
                                vy: Math.sin(aim) * spd,
                                radius: 4.5,
                                dmg: 14
                            });
                        }
                    }
                }

                for (let lIdx = lasers.length - 1; lIdx >= 0; lIdx--) {
                    const l = lasers[lIdx];
                    if (l.hitIds && l.hitIds.includes(obs)) continue;
                    const d = Math.hypot(l.x - obs.x, l.y - obs.y);
                    if (obs.hp > 0 && d < obs.radius + l.radius) {
                        const hitRes = rollDamageWithCrit(l.dmg);
                        triggerHaptic(14);

                        if (obs.type === 'elite_cruiser' && obs.frontShield > 0) {
                            obs.frontShield -= hitRes.dmg;
                            if (!l.piercing) lasers.splice(lIdx, 1);
                            else l.hitIds.push(obs);
                            spawnExplosion(l.x, l.y, '#00ffff', 6);
                            if (obs.frontShield <= 0) {
                                addFloatingText(obs.x, obs.y - 16, 'ESCUDO QUEBRADO!', '#00ffff');
                            }
                            continue;
                        }

                        obs.hp -= hitRes.dmg;

                        if (l.piercing && (obs.type === 'asteroid' || obs.type === 'drone')) {
                            l.hitIds.push(obs);
                        } else {
                            lasers.splice(lIdx, 1);
                        }

                        spawnExplosion(l.x, l.y, hitRes.isCrit ? '#fde047' : '#00ffff', hitRes.isCrit ? 7 : 4);
                        if (hitRes.isCrit) {
                            addFloatingText(obs.x, obs.y - 12, `CRÍTICO!`, '#fde047');
                        }

                        if (obs.hp <= 0) {
                            audio.playExplosion(false);
                            const isEnemy = obs.type === 'pirate' || obs.type === 'drone' || obs.type === 'mine' || obs.type === 'elite_cruiser';
                            triggerHaptic(isEnemy ? [30, 20, 40] : 22);
                            spawnExplosion(obs.x, obs.y, isEnemy ? '#ff3b5c' : '#94a3b8', 16, 4);

                            if (obs.type === 'asteroid') {
                                saveData.stats.asteroidsDestroyed += 1;
                            } else {
                                saveData.stats.enemiesDefeated += 1;
                            }

                            if (obs.type === 'pirate' || obs.type === 'elite_cruiser') {
                                spawnCollectible(obs.x, obs.y, true);
                            }

                            const basePts = obs.type === 'elite_cruiser' ? 240 : obs.type === 'pirate' ? 120 : obs.type === 'mine' ? 100 : obs.type === 'drone' ? 80 : 50;
                            const totalPts = registerKillCombo(basePts, obs.type === 'elite_cruiser' ? 18 : obs.type === 'pirate' ? 14 : 9);
                            addFloatingText(obs.x, obs.y, `+${totalPts}${comboCount > 1 ? ` (x${comboCount})` : ''}`, '#00ffff');
                        }
                    }
                }

                if (obs.hp > 0) {
                    const distPlayer = Math.hypot(player.x - obs.x, player.y - obs.y);
                    if (distPlayer < player.radius + obs.radius * 0.85) {
                        obs.hp = 0;
                        if (isOverdrive) {
                            audio.playExplosion(false);
                            triggerHaptic(25);
                            spawnExplosion(obs.x, obs.y, '#fde047', 18, 5);
                            if (obs.type === 'asteroid') saveData.stats.asteroidsDestroyed += 1;
                            else saveData.stats.enemiesDefeated += 1;
                            const pts = registerKillCombo(80, 0);
                            addFloatingText(obs.x, obs.y, `OVERDRIVE SMASH! +${pts}`, '#fde047');
                        } else if (centauriShieldCharges > 0) {
                            centauriShieldCharges--;
                            player.invulnerable = 1.0;
                            audio.playPickup('energy');
                            triggerHaptic(25);
                            spawnExplosion(player.x, player.y, '#fde047', 20, 6);
                            addFloatingText(player.x, player.y - 25, '👑 COROA CENTAURI ABSORVEU!', '#fde047');
                        } else if (player.invulnerable <= 0) {
                            player.invulnerable = 1.05;
                            const dmg = obs.type === 'elite_cruiser' ? 32 : obs.type === 'pirate' ? 26 : obs.type === 'drone' ? 24 : 20;
                            applyPlayerDamage(dmg, 'NAVE DESTRUÍDA', 'Os escudos entraram em colapso após múltiplos impactos.');
                        }
                    }
                }
            });
            obstacles = obstacles.filter(o => o.hp > 0 && o.y < height + 70 && o.x > -80 && o.x < width + 80);

            const effectiveMagnetRadius = isOverdrive
                ? 440
                : (activePowerups.magnet > 0 ? 310 : 80 + magnetLvl * 32);
            const puExtraTime = saveData.upgrades.reactor * 1.5;

            collectibles.forEach(c => {
                c.y += c.vy * worldSlowFactor * dt;
                c.phase += 4.5 * dt;

                const dist = Math.hypot(player.x - c.x, player.y - c.y);
                if (dist < effectiveMagnetRadius) {
                    const pull = (activePowerups.magnet > 0 || isOverdrive) ? 9.5 : 5.5;
                    c.x += (player.x - c.x) * pull * dt;
                    c.y += (player.y - c.y) * pull * dt;
                }

                if (dist < player.radius + c.radius + 6) {
                    c.collected = true;
                    audio.playPickup(c.kind);
                    triggerHaptic(18);

                    if (activeBounty && activeBounty.type === 'crystals') {
                        activeBounty.progress++;
                        if (activeBounty.progress >= activeBounty.target) {
                            completeActiveBounty();
                        }
                    }

                    if (c.kind === 'energy') {
                        player.energy = Math.min(player.maxEnergy, player.energy + 26);
                        player.shield = Math.min(player.maxShield, player.shield + 8);
                        score += 100 * comboCount;
                        addFloatingText(c.x, c.y, '+26% ENERGIA', '#00ffff');
                        spawnExplosion(c.x, c.y, '#00ffff', 8);
                    } else if (c.kind === 'multishot') {
                        activePowerups.multishot = 7.5 + puExtraTime;
                        score += 200 * comboCount;
                        addFloatingText(c.x, c.y, '🔱 TIRO TRIPLO!', '#38bdf8');
                        spawnExplosion(c.x, c.y, '#38bdf8', 12);
                    } else if (c.kind === 'magnet') {
                        activePowerups.magnet = 8.5 + puExtraTime;
                        score += 200 * comboCount;
                        addFloatingText(c.x, c.y, '🧲 ÍMÃ CÓSMICO!', '#c084fc');
                        spawnExplosion(c.x, c.y, '#c084fc', 12);
                    } else if (c.kind === 'overdrive') {
                        activePowerups.overdrive = 6.5 + puExtraTime;
                        score += 200 * comboCount;
                        addFloatingText(c.x, c.y, '🔥 SOBRECARGA!', '#fb923c');
                        spawnExplosion(c.x, c.y, '#fb923c', 12);
                    } else if (c.kind === 'wingman_reinforce') {
                        activePowerups.wingman_reinforce = 12.0 + puExtraTime;
                        score += 250 * comboCount;
                        addFloatingText(c.x, c.y, '✈️ REFORÇO DE FROTA (12s)!', '#10b981');
                        spawnExplosion(c.x, c.y, '#10b981', 14);
                    } else {
                        const baseCrystalGain = 2 + Math.floor(currentPlanetIndex * 0.5);
                        const modeMult = activeRunMode === 'INFINITE' ? 2 : 1;
                        const saturnMult = hasRelic('saturn_ring') ? 1.25 : 1.0;
                        const crystalGain = Math.max(1, Math.round(baseCrystalGain * modeMult * saturnMult * activeRunRisk.crystalMult));
                        runCrystals += crystalGain;
                        saveData.stats.crystalsCollected += crystalGain;
                        score += 150 * comboCount;
                        if (!isOverdrive) {
                            overdriveCharge = Math.min(100, overdriveCharge + 10);
                            if (overdriveCharge >= 100) activateOverdriveMode();
                        }
                        addFloatingText(c.x, c.y, `+${crystalGain} 💎 CRISTAIS`, '#fde047');
                        spawnExplosion(c.x, c.y, '#fde047', 10);
                    }
                }
            });
            collectibles = collectibles.filter(c => !c.collected && c.y < height + 40);

            particles.forEach(p => {
                p.x += p.vx * dt;
                p.y += p.vy * dt;
                p.life -= dt;
            });
            particles = particles.filter(p => p.life > 0);

            floatingTexts.forEach(ft => {
                ft.y -= 34 * dt;
                ft.life -= dt;
            });
            floatingTexts = floatingTexts.filter(ft => ft.life > 0);

            updateHUD();
        }

        // ==========================================
        // 8. LOOP DE RENDERIZAÇÃO PRINCIPAL (COM REAPLICAÇÃO DE TRANSFORM A CADA QUADRO)
        // ==========================================
        function render() {
            const curW = Math.max(window.innerWidth || 0, document.documentElement.clientWidth || 0, 360);
            const curH = Math.max(window.innerHeight || 0, document.documentElement.clientHeight || 0, 640);
            const curDpr = Math.min(window.devicePixelRatio || 1, 2);

            if (curW !== width || curH !== height || curDpr !== dpr) {
                width = curW;
                height = curH;
                dpr = curDpr;
                canvas.width = Math.round(width * dpr);
                canvas.height = Math.round(height * dpr);
            }

            // Garante que a matriz de escala dpr esteja sempre ativa no WebView Android
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

            const isWarping = overdriveActiveTimer > 0 || warpDriveBoostTimer > 0;
            ctx.save();

            if (Math.abs(cameraWarpZoom - 1.0) > 0.001) {
                ctx.translate(width / 2, height / 2);
                ctx.scale(cameraWarpZoom, cameraWarpZoom);
                ctx.translate(-width / 2, -height / 2);
            }

            if (shakeIntensity > 0.2) {
                const sx = (Math.random() - 0.5) * shakeIntensity;
                const sy = (Math.random() - 0.5) * shakeIntensity;
                ctx.translate(sx, sy);
            }

            ctx.fillStyle = '#070b14';
            ctx.fillRect(-30, -30, width + 60, height + 60);

            nebulas.forEach(n => {
                const grad = ctx.createRadialGradient(n.x, n.y, 10, n.x, n.y, n.r);
                grad.addColorStop(0, n.color);
                grad.addColorStop(1, 'rgba(7, 11, 20, 0)');
                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
                ctx.fill();
            });

            stars.forEach(s => {
                ctx.globalAlpha = s.alpha;
                if (isWarping) {
                    const streakLen = (overdriveActiveTimer > 0 ? 34 : 42) * s.speedMult;
                    const grad = ctx.createLinearGradient(s.x, s.y - streakLen, s.x, s.y + 4);
                    grad.addColorStop(0, 'rgba(0, 210, 255, 0)');
                    grad.addColorStop(0.6, s.tint);
                    grad.addColorStop(1, '#ffffff');
                    ctx.strokeStyle = grad;
                    ctx.lineWidth = s.size * 1.15;
                    ctx.beginPath();
                    ctx.moveTo(s.x, s.y - streakLen);
                    ctx.lineTo(s.x, s.y + 4);
                    ctx.stroke();
                } else {
                    ctx.fillStyle = s.tint;
                    ctx.beginPath();
                    ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                    ctx.fill();
                }
            });
            ctx.globalAlpha = 1;

            if (isWarping) {
                const tunnelGrad = ctx.createRadialGradient(
                    width / 2, height / 2, Math.min(width, height) * 0.34,
                    width / 2, height / 2, Math.max(width, height) * 0.78
                );
                tunnelGrad.addColorStop(0, 'rgba(0, 210, 255, 0)');
                tunnelGrad.addColorStop(0.75, overdriveActiveTimer > 0 ? 'rgba(250, 204, 21, 0.10)' : 'rgba(0, 210, 255, 0.12)');
                tunnelGrad.addColorStop(1, overdriveActiveTimer > 0 ? 'rgba(245, 158, 11, 0.34)' : 'rgba(0, 255, 255, 0.36)');
                ctx.fillStyle = tunnelGrad;
                ctx.fillRect(0, 0, width, height);
            }

            if (temporalStasisTimer > 0) {
                ctx.fillStyle = 'rgba(168, 85, 247, 0.08)';
                ctx.fillRect(0, 0, width, height);
            }

            if (solarStormActive > 0) {
                ctx.fillStyle = 'rgba(245, 158, 11, 0.08)';
                ctx.fillRect(0, 0, width, height);
            }

            if (planetApproaching && approachingPlanet) {
                drawPlanetBody(ctx, approachingPlanet.data, approachingPlanet.x, approachingPlanet.y, approachingPlanet.data.radius * 1.35);
            }

            blackHoles.forEach(drawBlackHole);
            warpPortals.forEach(drawWarpPortal);
            supplySatellites.forEach(drawSupplySatellite);
            if (merchantShip) drawMerchantShip(merchantShip);
            collectibles.forEach(drawCollectible);
            obstacles.forEach(drawObstacle);
            if (activeBoss) drawBoss(activeBoss);

            lasers.forEach(l => {
                ctx.save();
                ctx.fillStyle = l.color || '#00ffff';
                ctx.shadowColor = l.color || '#00ffff';
                ctx.shadowBlur = 12;
                ctx.beginPath();
                ctx.roundRect(l.x - l.radius * 0.7, l.y - 14, l.radius * 1.4, 28, 4);
                ctx.fill();

                ctx.fillStyle = '#ffffff';
                ctx.beginPath();
                ctx.roundRect(l.x - l.radius * 0.3, l.y - 11, l.radius * 0.6, 20, 3);
                ctx.fill();
                ctx.restore();
            });

            homingMissiles.forEach(m => {
                ctx.save();
                ctx.fillStyle = '#fde047';
                ctx.shadowColor = '#f59e0b';
                ctx.shadowBlur = 10;
                ctx.beginPath();
                ctx.arc(m.x, m.y, 4.5, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            enemyLasers.forEach(el => {
                ctx.save();
                ctx.fillStyle = '#ff3b5c';
                ctx.shadowColor = '#ff3b5c';
                ctx.shadowBlur = 10;
                ctx.beginPath();
                ctx.arc(el.x, el.y, el.radius, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            if (gameState === 'PLAYING' || gameState === 'PLANET_MODAL' || gameState === 'PAUSED' || gameState === 'MERCHANT_MODAL') {
                const ship = getActiveShip();
                const skin = getActiveSkin();
                wingmenShips.forEach(wm => {
                    drawSpaceship(wm.x, wm.y, player.radius * 0.66, ship, ctx, wm.phase, skin);
                });

                drawSpaceship(player.x, player.y, player.radius);
                drawDrones();
                drawOrbitalSphere();
            }

            particles.forEach(p => {
                ctx.save();
                ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
                ctx.fillStyle = p.color;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            floatingTexts.forEach(ft => {
                ctx.save();
                ctx.globalAlpha = Math.max(0, ft.life);
                ctx.font = 'bold 12px Orbitron';
                ctx.fillStyle = ft.color;
                ctx.textAlign = 'center';
                ctx.shadowColor = 'rgba(0,0,0,0.85)';
                ctx.shadowBlur = 4;
                ctx.fillText(ft.text, ft.x, ft.y);
                ctx.restore();
            });

            ctx.restore();
        }

        function gameLoop(timestamp) {
            if (!lastTime) lastTime = timestamp;
            const dt = Math.min(0.05, (timestamp - lastTime) / 1000);
            lastTime = timestamp;

            update(dt);
            render();

            requestAnimationFrame(gameLoop);
        }

        // ==========================================
        // 9. MODAIS DE INSTALAÇÃO PWA, ROLETA CÓSMICA, PASSE GALÁCTICO, HANGAR, OFICINA, PROVAS & CATÁLOGO
