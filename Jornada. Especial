        // ==========================================
        function drawPlanetBody(context, planet, cx, cy, radius) {
            context.save();
            context.translate(cx, cy);

            const glowGrad = context.createRadialGradient(0, 0, radius * 0.85, 0, 0, radius * 1.45);
            glowGrad.addColorStop(0, planet.atmosphere);
            glowGrad.addColorStop(1, 'rgba(0, 0, 0, 0)');
            context.fillStyle = glowGrad;
            context.beginPath();
            context.arc(0, 0, radius * 1.45, 0, Math.PI * 2);
            context.fill();

            if (planet.hasRing) {
                context.save();
                context.rotate(-0.35);
                context.strokeStyle = planet.ringColor;
                context.lineWidth = Math.max(4, radius * 0.14);
                context.beginPath();
                context.ellipse(0, 0, radius * 1.75, radius * 0.42, 0, Math.PI, Math.PI * 2);
                context.stroke();
                context.restore();
            }

            const bodyGrad = context.createRadialGradient(-radius * 0.35, -radius * 0.35, radius * 0.1, 0, 0, radius);
            bodyGrad.addColorStop(0, planet.colors[0]);
            bodyGrad.addColorStop(0.55, planet.colors[1]);
            bodyGrad.addColorStop(1, planet.colors[2]);

            context.fillStyle = bodyGrad;
            context.beginPath();
            context.arc(0, 0, radius, 0, Math.PI * 2);
            context.fill();

            context.save();
            context.beginPath();
            context.arc(0, 0, radius, 0, Math.PI * 2);
            context.clip();

            if (planet.bands) {
                context.fillStyle = 'rgba(255, 255, 255, 0.12)';
                context.fillRect(-radius, -radius * 0.45, radius * 2, radius * 0.18);
                context.fillStyle = 'rgba(0, 0, 0, 0.16)';
                context.fillRect(-radius, radius * 0.15, radius * 2, radius * 0.22);
            }

            if (planet.isEarth) {
                context.fillStyle = 'rgba(16, 185, 129, 0.55)';
                context.beginPath();
                context.arc(-radius * 0.25, -radius * 0.15, radius * 0.35, 0, Math.PI * 2);
                context.arc(radius * 0.3, radius * 0.2, radius * 0.28, 0, Math.PI * 2);
                context.fill();
            }

            if (planet.craters) {
                context.fillStyle = 'rgba(0, 0, 0, 0.22)';
                context.beginPath();
                context.arc(-radius * 0.3, radius * 0.25, radius * 0.18, 0, Math.PI * 2);
                context.arc(radius * 0.25, -radius * 0.28, radius * 0.14, 0, Math.PI * 2);
                context.arc(radius * 0.1, radius * 0.35, radius * 0.11, 0, Math.PI * 2);
                context.fill();
            }

            const shadowGrad = context.createLinearGradient(-radius, -radius, radius, radius);
            shadowGrad.addColorStop(0, 'rgba(0,0,0,0)');
            shadowGrad.addColorStop(0.65, 'rgba(0,0,0,0.15)');
            shadowGrad.addColorStop(1, 'rgba(0,0,0,0.65)');
            context.fillStyle = shadowGrad;
            context.fillRect(-radius, -radius, radius * 2, radius * 2);
            context.restore();

            if (planet.hasRing) {
                context.save();
                context.rotate(-0.35);
                context.strokeStyle = planet.ringColor;
                context.lineWidth = Math.max(4, radius * 0.14);
                context.beginPath();
                context.ellipse(0, 0, radius * 1.75, radius * 0.42, 0, 0, Math.PI);
                context.stroke();
                context.restore();
            }

            context.restore();
        }

        function drawSpaceship(x, y, radius, customShip = null, targetContext = ctx, previewPhase = 0, customSkin = null) {
            const ship = customShip || getActiveShip();
            const skin = customSkin || getActiveSkin();
            const isOverdrive = !customShip && overdriveActiveTimer > 0;
            targetContext.save();
            targetContext.translate(x, y);

            // Clarão de disparo (muzzle flash) visível na ponta dos canhões
