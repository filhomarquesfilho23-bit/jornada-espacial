                    } else if (mineLvl < maxMineLvl) {
                        yieldInfo.innerHTML = `<span class="text-emerald-300">⛏️ +${currentYield} 💎/min</span> <span class="text-slate-400">→ Próx: +${nextYield}/min</span>`;
