        function spinCosmicWheel(isExtraAdSpin = false) {
            if (isWheelSpinning) return;
            audio.init();
            isWheelSpinning = true;
            updateCosmicWheelUI();

            const winningIndex = Math.floor(Math.random() * COSMIC_WHEEL_SLICES.length);
            const sliceAngle = (Math.PI * 2) / COSMIC_WHEEL_SLICES.length;
            const targetSliceCenter = winningIndex * sliceAngle + sliceAngle / 2;
            const desiredFinalAngle = -Math.PI / 2 - targetSliceCenter;
            const currentNorm = wheelRotationAngle % (Math.PI * 2);
            let delta = desiredFinalAngle - currentNorm;
            while (delta < 0) delta += Math.PI * 2;
            const totalSpin = delta + Math.PI * 2 * 6;

            const startAngle = wheelRotationAngle;
            const duration = 3400;
            const startTime = performance.now();

            function animateWheel(now) {
                const elapsed = now - startTime;
                const t = Math.min(1, elapsed / duration);
                const easeOut = 1 - Math.pow(1 - t, 4);
                wheelRotationAngle = startAngle + totalSpin * easeOut;
                drawCosmicWheel(wheelRotationAngle);

                if (t < 1) {
                    requestAnimationFrame(animateWheel);
                } else {
                    isWheelSpinning = false;
                    const prize = COSMIC_WHEEL_SLICES[winningIndex];
                    if (isExtraAdSpin) {
                        saveData.wheelExtraSpinsUsedToday = (saveData.wheelExtraSpinsUsedToday || 0) + 1;
                    } else {
                        saveData.lastFreeWheelTimestamp = Date.now();
                    }

                    if (prize.type === 'crystals') {
                        saveData.crystals += prize.amount;
                    } else if (prize.type === 'pass_xp') {
                        saveData.seasonPassXp = (saveData.seasonPassXp || 0) + prize.amount;
                    } else if (prize.type === 'start_overdrive') {
                        saveData.pendingStartOverdrive = true;
                    }

                    writeSaveData(saveData);
                    audio.playLevelUp();
                    triggerHaptic([45, 30, 80]);
                    updateCosmicWheelUI();
                    refreshStartScreenStats();

                    const extraInfo = prize.type === 'start_overdrive'
                        ? 'Você começará a próxima partida em Overdrive Cósmico!'
                        : `Prêmio creditado: ${prize.label}!`;
                    showToast(`🎰 Roleta Cósmica: ${extraInfo}`);
                }
            }

            requestAnimationFrame(animateWheel);
        }

