        function registerKillCombo(basePoints, overdriveGain = 9) {
            comboTimer = 3.2;
            comboCount = Math.min(8, comboCount + 1);
            if (comboCount > lastRunMaxCombo) {
                lastRunMaxCombo = comboCount;
            }
            if (comboCount > (saveData.stats.bestCombo || 1)) {
                saveData.stats.bestCombo = comboCount;
                writeSaveData(saveData);
            }
            if (comboCount >= 8) {
                unlockTrial('trial_combo_8');
            }
            if (activeBounty && activeBounty.type === 'kills') {
                activeBounty.progress++;
                if (activeBounty.progress >= activeBounty.target) {
                    completeActiveBounty();
                }
            }
            if (overdriveActiveTimer <= 0) {
                overdriveCharge = Math.min(100, overdriveCharge + overdriveGain);
                if (overdriveCharge >= 100) {
                    activateOverdriveMode();
                }
            }
            const earned = basePoints * comboCount;
            score += earned;
            return earned;
        }

        function spawnObstacle(isShower = false, initialY = null) {
            const radius = isShower ? (12 + Math.random() * 14) : (16 + Math.random() * 20);
            const x = radius + 16 + Math.random() * Math.max(40, width - radius * 2 - 32);

            let type = 'asteroid';
            if (!isShower && initialY === null) {
                const eliteChance = Math.min(0.16, Math.max(0, (totalRunDistance - 2400) / 18000));
                const pirateChance = Math.min(0.24, 0.08 + currentPlanetIndex * 0.02);
                const mineChance = Math.min(0.16, 0.05 + currentPlanetIndex * 0.015);
                const droneChance = Math.min(0.22, 0.10 + currentPlanetIndex * 0.02);
                const r = Math.random();
                if (r < eliteChance) type = 'elite_cruiser';
                else if (r < eliteChance + pirateChance) type = 'pirate';
                else if (r < eliteChance + pirateChance + mineChance) type = 'mine';
                else if (r < eliteChance + pirateChance + mineChance + droneChance) type = 'drone';
            }

            const vertices = [];
            if (type === 'asteroid') {
                const sides = 7 + Math.floor(Math.random() * 4);
                for (let i = 0; i < sides; i++) {
                    vertices.push({
                        angle: (i / sides) * Math.PI * 2,
                        dist: 0.78 + Math.random() * 0.35
                    });
                }
            }

            const speedMult = activeRunRisk.speedMult;
            const speedY = isShower
                ? (baseSpeed + 190 + Math.random() * 150) * speedMult
                : type === 'elite_cruiser'
                    ? (baseSpeed * 0.72) * speedMult
                    : type === 'pirate'
                        ? (baseSpeed + 55 + Math.random() * 70) * speedMult
                        : type === 'mine'
                            ? (baseSpeed * 0.85 + Math.random() * 45) * speedMult
                            : (baseSpeed + 40 + Math.random() * 110 + currentPlanetIndex * 16) * speedMult;

            const hp = type === 'elite_cruiser'
                ? 5 + Math.floor(currentPlanetIndex * 0.5)
                : type === 'pirate'
                    ? 2 + Math.floor(currentPlanetIndex * 0.25)
                    : type === 'mine'
                        ? 2
                        : type === 'drone'
                            ? 2
                            : Math.ceil(radius / 14);

            obstacles.push({
                x,
                y: initialY !== null ? initialY : (-radius - 16),
                vx: type === 'pirate' ? (Math.random() < 0.5 ? -85 : 85) : (Math.random() - 0.5) * 45,
                vy: speedY,
                radius: type === 'elite_cruiser' ? 26 : type === 'pirate' ? 19 : type === 'mine' ? 17 : radius,
                rotation: Math.random() * Math.PI * 2,
                rotSpeed: (Math.random() - 0.5) * 2.5,
                type,
                isShower,
                vertices,
                hp,
                frontShield: type === 'elite_cruiser' ? 3 : 0,
                shootTimer: 0.8 + Math.random() * 1.1
            });
        }

        function spawnCollectible(xPos = null, yPos = null, forceCrystal = false) {
            const radius = 13;
            const x = xPos !== null ? xPos : (radius + 20 + Math.random() * Math.max(40, width - radius * 2 - 40));
            const y = yPos !== null ? yPos : -18;

            let kind = 'energy';
            if (forceCrystal) {
                kind = 'crystal';
            } else {
