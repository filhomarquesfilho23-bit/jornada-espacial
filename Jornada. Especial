        let generatedPosterDataUrl = '';

        function generateRecordPosterImage() {
            const pCanvas = document.createElement('canvas');
            pCanvas.width = 600;
            pCanvas.height = 800;
            const pCtx = pCanvas.getContext('2d');

            const skin = getActiveSkin();
            const ship = getActiveShip();
            const rankInfo = getPilotRankInfo();
            const finalScoreStr = Math.floor(score).toLocaleString('pt-BR');
            const distStr = `${Math.floor(totalRunDistance).toLocaleString('pt-BR')} km`;
            const comboStr = `x${Math.max(lastRunMaxCombo, comboCount)}`;

            const bgGrad = pCtx.createLinearGradient(0, 0, 0, 800);
            bgGrad.addColorStop(0, '#070b14');
            bgGrad.addColorStop(0.5, '#0d1528');
            bgGrad.addColorStop(1, '#070b14');
            pCtx.fillStyle = bgGrad;
            pCtx.fillRect(0, 0, 600, 800);

            const neb1 = pCtx.createRadialGradient(130, 180, 20, 130, 180, 260);
            neb1.addColorStop(0, 'rgba(0, 210, 255, 0.18)');
            neb1.addColorStop(1, 'rgba(0, 210, 255, 0)');
            pCtx.fillStyle = neb1;
            pCtx.fillRect(0, 0, 600, 800);

            const neb2 = pCtx.createRadialGradient(470, 540, 20, 470, 540, 280);
            neb2.addColorStop(0, 'rgba(250, 204, 21, 0.14)');
            neb2.addColorStop(1, 'rgba(250, 204, 21, 0)');
            pCtx.fillStyle = neb2;
            pCtx.fillRect(0, 0, 600, 800);

            for (let i = 0; i < 65; i++) {
                const sx = (i * 97) % 580 + 10;
                const sy = (i * 151) % 780 + 10;
                const sr = (i % 3 === 0) ? 2.2 : 1.2;
                pCtx.fillStyle = i % 4 === 0 ? '#00ffff' : 'rgba(255,255,255,0.65)';
                pCtx.beginPath();
                pCtx.arc(sx, sy, sr, 0, Math.PI * 2);
                pCtx.fill();
            }

            pCtx.strokeStyle = skin.primaryColor;
            pCtx.lineWidth = 4;
            pCtx.shadowColor = skin.primaryColor;
            pCtx.shadowBlur = 18;
            pCtx.beginPath();
            pCtx.roundRect(22, 22, 556, 756, 30);
            pCtx.stroke();
            pCtx.shadowBlur = 0;

            pCtx.fillStyle = 'rgba(0, 210, 255, 0.16)';
            pCtx.beginPath();
            pCtx.roundRect(145, 48, 310, 34, 17);
            pCtx.fill();
            pCtx.fillStyle = '#67e8f9';
            pCtx.font = 'bold 13px Orbitron';
            pCtx.textAlign = 'center';
            pCtx.fillText('REGISTRO OFICIAL DE EXPEDIÇÃO', 300, 70);

            pCtx.fillStyle = '#ffffff';
            pCtx.shadowColor = 'rgba(0, 210, 255, 0.8)';
            pCtx.shadowBlur = 20;
            pCtx.font = '900 40px Orbitron';
            pCtx.fillText('JORNADA ESPACIAL', 300, 128);
            pCtx.shadowBlur = 0;

            pCtx.fillStyle = '#fde047';
            pCtx.font = 'bold 17px Orbitron';
            pCtx.fillText(`🎖️ ${rankInfo.title}`, 300, 162);

            const halo = pCtx.createRadialGradient(300, 285, 25, 300, 285, 115);
            halo.addColorStop(0, `rgba(${skin.shieldRgb}, 0.35)`);
            halo.addColorStop(1, 'rgba(0,0,0,0)');
            pCtx.fillStyle = halo;
            pCtx.beginPath();
            pCtx.arc(300, 285, 115, 0, Math.PI * 2);
            pCtx.fill();

            drawSpaceship(300, 290, 46, ship, pCtx, 1.4, skin);

            pCtx.fillStyle = '#cbd5e1';
            pCtx.font = 'bold 15px Orbitron';
            pCtx.fillText(`${ship.name.toUpperCase()} • ${skin.name.toUpperCase()}`, 300, 378);

            pCtx.fillStyle = 'rgba(15, 23, 42, 0.88)';
            pCtx.strokeStyle = 'rgba(0, 255, 255, 0.45)';
            pCtx.lineWidth = 2;
            pCtx.beginPath();
            pCtx.roundRect(52, 405, 496, 112, 22);
            pCtx.fill();
            pCtx.stroke();

            pCtx.fillStyle = '#38bdf8';
            pCtx.font = 'bold 14px Orbitron';
            pCtx.fillText('PONTUAÇÃO ALCANÇADA', 300, 436);

            pCtx.fillStyle = '#ffffff';
            pCtx.shadowColor = '#00ffff';
            pCtx.shadowBlur = 14;
            pCtx.font = '900 46px Orbitron';
            pCtx.fillText(finalScoreStr, 300, 492);
            pCtx.shadowBlur = 0;

            const statsCards = [
                { label: 'MAIOR COMBO', value: comboStr, color: '#fde047' },
                { label: 'DISTÂNCIA', value: distStr, color: '#34d399' },
                { label: 'DESTINO / SETOR', value: lastRunPlanetReached.toUpperCase(), color: '#67e8f9' }
            ];

            statsCards.forEach((st, idx) => {
                const yTop = 536 + idx * 56;
                pCtx.fillStyle = 'rgba(15, 23, 42, 0.85)';
                pCtx.strokeStyle = 'rgba(148, 163, 184, 0.25)';
                pCtx.lineWidth = 1.5;
                pCtx.beginPath();
                pCtx.roundRect(52, yTop, 496, 46, 14);
                pCtx.fill();
                pCtx.stroke();

                pCtx.textAlign = 'left';
                pCtx.fillStyle = '#94a3b8';
                pCtx.font = 'bold 13px Orbitron';
                pCtx.fillText(st.label, 72, yTop + 28);

                pCtx.textAlign = 'right';
                pCtx.fillStyle = st.color;
                pCtx.font = 'bold 15px Orbitron';
                pCtx.fillText(st.value, 528, yTop + 28);
            });

            pCtx.textAlign = 'center';
            pCtx.fillStyle = '#00ffff';
            pCtx.font = 'bold 18px Orbitron';
            pCtx.fillText('Jogue agora no celular!', 300, 742);

            pCtx.fillStyle = '#64748b';
            pCtx.font = '12px Inter';
            pCtx.fillText('Edição Comandante de Frota • Desafio Interestelar', 300, 764);

            return pCanvas.toDataURL('image/png');
        }

