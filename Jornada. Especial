        let pointerOffsetY = 0;

        function handlePointerStart(clientX, clientY) {
            if (gameState !== 'PLAYING') return;
            audio.init();
            isPointerDown = true;
            const dist = Math.hypot(clientX - player.x, clientY - player.y);
            if (dist < 75) {
                pointerOffsetX = player.x - clientX;
                pointerOffsetY = player.y - clientY;
            } else {
                pointerOffsetX = 0;
                pointerOffsetY = -44;
                player.targetX = clientX;
                player.targetY = clientY - 44;
            }
        }

        function handlePointerMove(clientX, clientY) {
            if (!isPointerDown || gameState !== 'PLAYING') return;
            const stormJitter = solarStormActive > 0 ? Math.sin(performance.now() * 0.025) * 18 : 0;
            player.targetX = clientX + pointerOffsetX + stormJitter;
            player.targetY = clientY + pointerOffsetY;
        }

        function handlePointerEnd() {
            isPointerDown = false;
        }

        canvas.addEventListener('touchstart', (e) => {
            if (gameState !== 'PLAYING') return;
            if (e.touches.length > 0) {
                handlePointerStart(e.touches[0].clientX, e.touches[0].clientY);
            }
        }, { passive: true });

        canvas.addEventListener('touchmove', (e) => {
            if (gameState !== 'PLAYING') return;
