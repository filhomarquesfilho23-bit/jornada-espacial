                if (r < 0.12) kind = 'multishot';
                else if (r < 0.22) kind = 'magnet';
                else if (r < 0.30) kind = 'overdrive';
                else if (r < 0.38) kind = 'wingman_reinforce';
                else if (r < 0.64) kind = 'crystal';
                else kind = 'energy';
            }

            collectibles.push({
                x,
                y,
                vy: baseSpeed * 0.85,
                radius,
                kind,
                phase: Math.random() * Math.PI * 2
            });
        }

