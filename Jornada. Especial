        function getPilotRankInfo() {
            const pts =
                saveData.visitedPlanets.length * 120 +
                (saveData.stats.bossesBeaten || 0) * 180 +
                Math.floor((saveData.stats.totalDistanceKm || 0) / 100) +
                (saveData.completedTrials.length * 150);

            const ranks = [
                { min: 0, title: 'CADETE ESTELAR', next: 300 },
                { min: 300, title: 'PILOTO EXPLORADOR', next: 900 },
                { min: 900, title: 'CAPITÃO DE FROTA', next: 2000 },
                { min: 2000, title: 'ALMIRANTE CÓSMICO', next: 3800 },
                { min: 3800, title: 'COMANDANTE SUPREMO', next: 6000 }
            ];

            let current = ranks[0];
            for (const r of ranks) {
                if (pts >= r.min) current = r;
            }
            const isMax = current.min === 3800;
            const progressPct = isMax
                ? 100
                : Math.min(100, Math.max(8, ((pts - current.min) / (current.next - current.min)) * 100));
            const nextHint = isMax
                ? 'Patente máxima alcançada! Domine o Setor Abissal.'
                : `${pts} / ${current.next} XP Galáctico para próxima patente`;
            return { title: current.title, progressPct, nextHint };
        }

        function getSeasonPassProgress() {
            const xp = saveData.seasonPassXp || 0;
            let currentTierObj = SEASON_PASS_TIERS[0];
            let nextTierObj = SEASON_PASS_TIERS[1];

            for (let i = 0; i < SEASON_PASS_TIERS.length; i++) {
                if (xp >= SEASON_PASS_TIERS[i].xpRequired) {
                    currentTierObj = SEASON_PASS_TIERS[i];
                    nextTierObj = SEASON_PASS_TIERS[i + 1] || null;
                }
            }

            let pct = 100;
            let xpLabel = `${xp.toLocaleString('pt-BR')} XP (MÁX)`;
            if (nextTierObj) {
                const span = nextTierObj.xpRequired - currentTierObj.xpRequired;
                const earnedInTier = xp - currentTierObj.xpRequired;
                pct = Math.min(100, Math.max(4, Math.round((earnedInTier / span) * 100)));
                xpLabel = `${xp.toLocaleString('pt-BR')} / ${nextTierObj.xpRequired.toLocaleString('pt-BR')} XP`;
            }

            const claimableCount = SEASON_PASS_TIERS.filter(
                t => xp >= t.xpRequired && !saveData.claimedPassTiers.includes(t.tier)
            ).length;

            return {
                tier: currentTierObj.tier,
                xp,
                pct,
                xpLabel,
                claimableCount
            };
        }

